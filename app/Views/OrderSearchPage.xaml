<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:app.Models"
             xmlns:views="clr-namespace:app.Views"
             x:Class="app.Views.OrderSearchPage"
             x:DataType="views:OrderSearchPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="NavOutlineButton"
                   TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="Transparent"/>
                <Setter Property="TextColor"
                        Value="White"/>
                <Setter Property="BorderColor"
                        Value="White"/>
                <Setter Property="BorderWidth"
                        Value="1"/>
                <Setter Property="FontSize"
                        Value="12"/>
                <Setter Property="Padding"
                        Value="14,6"/>
                <Setter Property="CornerRadius"
                        Value="6"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="Transparent"/>
                                    <Setter Property="TextColor"
                                            Value="White"/>
                                    <Setter Property="BorderColor"
                                            Value="White"/>
                                    <Setter Property="BorderWidth"
                                            Value="1"/>
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="White"/>
                                    <Setter Property="TextColor"
                                            Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderColor"
                                            Value="White"/>
                                    <Setter Property="BorderWidth"
                                            Value="1"/>
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="#e0e7ff"/>
                                    <Setter Property="TextColor"
                                            Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderColor"
                                            Value="White"/>
                                    <Setter Property="Opacity"
                                            Value="0.85"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="0.35"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Filled button with pointer-over highlight -->
            <Style x:Key="HoverButton"
                   TargetType="Button">
                <Setter Property="CornerRadius"
                        Value="6"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="0.78"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="0.6"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="0.35"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">

        <!-- Header bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              BackgroundColor="{StaticResource Primary}"
              Padding="12,7">

            <!-- Left: Home button -->
            <HorizontalStackLayout Grid.Column="0"
                                   Spacing="10"
                                   VerticalOptions="Center">
                <Button Text="⌂ Home"
                        Clicked="OnGoHome"
                        Style="{StaticResource NavOutlineButton}"/>
            </HorizontalStackLayout>

            <!-- Center: swappable order info ↔ scan alert -->
            <Grid Grid.Column="1"
                  HorizontalOptions="Fill"
                  VerticalOptions="Center">
                <!-- Default: order metadata -->
                <HorizontalStackLayout x:Name="HeaderOrderInfo"
                                       HorizontalOptions="Center"
                                       Spacing="12"
                                       VerticalOptions="Center">
                    <Label x:Name="HeaderOrderLabel"
                           Text="ORDER"
                           TextColor="#94a3b8"
                           FontSize="15"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           IsVisible="False"/>
                    <Label x:Name="HeaderOrderNumber"
                           Text=""
                           TextColor="White"
                           FontSize="17"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           IsVisible="False"/>
                    <Border x:Name="HeaderPlatformBadge"
                            IsVisible="False"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 4"
                            Padding="10,3">
                        <Label x:Name="HeaderPlatformLabel"
                               Text=""
                               TextColor="White"
                               FontSize="13"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </Border>
                    <Label x:Name="HeaderTrackingLabel"
                           Text=""
                           TextColor="White"
                           FontSize="17"
                           VerticalOptions="Center"
                           IsVisible="False"/>
                    <!-- Marketplace order status pill (e.g. Cancelled) — compact header style -->
                    <Border IsVisible="{Binding CurrentOrder.HasOrderStatus}"
                            BackgroundColor="{Binding CurrentOrder.OrderStatusBgColor}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 4"
                            Padding="10,3"
                            VerticalOptions="Center">
                        <Label Text="{Binding CurrentOrder.OrderStatusDisplay}"
                               TextColor="{Binding CurrentOrder.OrderStatusFgColor}"
                               FontSize="12"
                               FontAttributes="Bold"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Scan alert pill (hidden by default, shown on scan events) -->
                <Border x:Name="HeaderScanAlert"
                        IsVisible="False"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,6"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Opacity="0">
                    <HorizontalStackLayout Spacing="8"
                                           VerticalOptions="Center">
                        <Label x:Name="ScanAlertIcon"
                               Text="SCAN"
                               FontSize="9"
                               FontAttributes="Bold"
                               TextColor="White"
                               Opacity="0.8"
                               VerticalOptions="Center"/>
                        <Border x:Name="ScanAlertSkuBadge"
                                BackgroundColor="#20ffffff"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 4"
                                Padding="6,2">
                            <Label x:Name="ScanAlertSkuLabel"
                                   Text=""
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   FontFamily="Consolas"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label x:Name="ScanAlertMessage"
                               Text=""
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Right: search → COM status → operator -->
            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="10"
                                   VerticalOptions="Center">

                <!-- Command-palette search trigger (physical-key style) -->
                <Border x:Name="SearchBoxBorder"
                        BackgroundColor="#33ffffff"
                        Stroke="#4Dffffff"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="8,4"
                        HeightRequest="34"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchBoxTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8"
                                           VerticalOptions="Center">
                        <!-- "/" keycap with 3D shadow effect -->
                        <Border x:Name="SearchSlashHint"
                                BackgroundColor="#7c6bc4"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 6"
                                Padding="0"
                                HeightRequest="24"
                                WidthRequest="24"
                                VerticalOptions="Center">
                            <Border.Shadow>
                                <Shadow Brush="#33000000"
                                        Offset="0,2"
                                        Radius="0"/>
                            </Border.Shadow>
                            <Label Text="/"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Border>
                        <Label x:Name="SearchPlaceholderLabel"
                               Text="search"
                               TextColor="White"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               VerticalOptions="Center"/>
                        <!-- Hidden entry (popup handles actual input) -->
                        <Entry x:Name="HeaderSearchEntry"
                               IsVisible="False"
                               TextColor="White"
                               FontSize="13"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#60ffffff"
                               ReturnType="Search"
                               Completed="OnSearchCommitted"
                               Focused="OnSearchEntryFocused"
                               Unfocused="OnSearchEntryUnfocused"
                               WidthRequest="0"
                               HeightRequest="0"/>
                    </HorizontalStackLayout>
                </Border>

                <Label Text="|"
                       TextColor="#40ffffff"
                       FontSize="16"
                       VerticalOptions="Center"/>

                <!-- COM port dropdown badge -->
                <Border x:Name="ComPortBadge"
                        BackgroundColor="#1Affffff"
                        Stroke="#30ffffff"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 6"
                        Padding="12,6"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnComPortBadgeTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="COM"
                               TextColor="#94a3b8"
                               FontSize="10"
                               VerticalOptions="Center"/>
                        <Label x:Name="ComPortBadgeLabel"
                               Text="None"
                               TextColor="White"
                               FontSize="12"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <Label Text="▾"
                               TextColor="#94a3b8"
                               FontSize="10"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Label Text="|"
                       TextColor="#40ffffff"
                       FontSize="16"
                       VerticalOptions="Center"/>

                <!-- Computer · Operator -->
                <Border x:Name="OperatorHeaderBadge"
                        IsVisible="False"
                        BackgroundColor="Transparent"
                        Stroke="Transparent"
                        Padding="0">
                    <Label x:Name="HeaderComputerOperatorLabel"
                           Text=""
                           TextColor="White"
                           FontSize="13"
                           VerticalOptions="Center"/>
                </Border>
            </HorizontalStackLayout>

        </Grid>

        <!-- COM port dropdown popover -->
        <Grid x:Name="ComPortDropdownBackdrop"
              Grid.Row="0"
              Grid.RowSpan="5"
              BackgroundColor="Transparent"
              IsVisible="False"
              ZIndex="20"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnComPortDropdownBackdropTapped"/>
            </Grid.GestureRecognizers>
            <Border x:Name="ComPortDropdownCard"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,48,240,0"
                    Stroke="#e5e7eb"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6"
                    BackgroundColor="White"
                    Padding="0"
                    WidthRequest="240"
                    InputTransparent="False">
                <Border.Shadow>
                    <Shadow Brush="#26000000"
                            Offset="0,4"
                            Radius="12"/>
                </Border.Shadow>
                <VerticalStackLayout x:Name="ComPortDropdownList"
                                     Spacing="0"
                                     Padding="8"/>
            </Border>
        </Grid>

        <!-- Row 1: collapsed (metadata removed) -->
        <Grid Grid.Row="1"
              HeightRequest="0"
              IsVisible="False"/>

        <!-- ── History section: stats + carousel (unified belt) ────── -->
        <Border Grid.Row="2"
                BackgroundColor="White"
                Stroke="#e5e7eb"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 0"
                Margin="0">
            <VerticalStackLayout Spacing="0">

                <!-- History belt: stats pills + carousel -->
                <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto"
                      ColumnSpacing="0">

                    <Label x:Name="SessionTotalLabel"
                           IsVisible="False"
                           Text="0"/>

                    <!-- Summary stats pills -->
                    <HorizontalStackLayout Grid.Column="0"
                                           Spacing="4"
                                           VerticalOptions="Center"
                                           Padding="6,0">
                        <!-- Green: Completed -->
                        <Border x:Name="SessionCompletedBadge"
                                BackgroundColor="#f0fdf4"
                                Stroke="#bbf7d0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 4"
                                Padding="8,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSessionCompletedBadgeTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="4"
                                                   VerticalOptions="Center">
                                <BoxView WidthRequest="6"
                                         HeightRequest="6"
                                         Color="#16a34a"
                                         CornerRadius="3"
                                         VerticalOptions="Center"/>
                                <Label x:Name="SessionCompletedLabel"
                                       Text="0"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#166534"
                                       VerticalOptions="Center"/>
                                <Label Text="Completed"
                                       FontSize="10"
                                       TextColor="#6b7280"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                        <!-- Orange: Incompleted -->
                        <Border x:Name="SessionIncompleteBadge"
                                BackgroundColor="#fffbeb"
                                Stroke="#fde68a"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 4"
                                Padding="8,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSessionIncompleteBadgeTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="4"
                                                   VerticalOptions="Center">
                                <BoxView WidthRequest="6"
                                         HeightRequest="6"
                                         Color="#d97706"
                                         CornerRadius="3"
                                         VerticalOptions="Center"/>
                                <Label x:Name="SessionIncompleteLabel"
                                       Text="0"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#b45309"
                                       VerticalOptions="Center"/>
                                <Label Text="Incompleted"
                                       FontSize="10"
                                       TextColor="#6b7280"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                        <!-- Blue: Incoming -->
                        <Border x:Name="SessionIncomingBadge"
                                BackgroundColor="#eff6ff"
                                Stroke="#bfdbfe"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 4"
                                Padding="8,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSessionIncomingBadgeTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="4"
                                                   VerticalOptions="Center">
                                <BoxView WidthRequest="6"
                                         HeightRequest="6"
                                         Color="#2563eb"
                                         CornerRadius="3"
                                         VerticalOptions="Center"/>
                                <Label x:Name="SessionIncomingLabel"
                                       Text="0"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#1d4ed8"
                                       VerticalOptions="Center"/>
                                <Label Text="Incoming"
                                       FontSize="10"
                                       TextColor="#6b7280"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Vertical divider -->
                    <BoxView Grid.Column="1"
                             WidthRequest="1"
                             BackgroundColor="#e5e7eb"
                             VerticalOptions="Center"
                             HeightRequest="24"
                             Margin="4,0"/>

                    <!-- Left arrow -->
                    <Border Grid.Column="2"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="8,4"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCarouselPrevTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="‹"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#9ca3af"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Border>

                    <!-- Carousel -->
                    <ScrollView x:Name="NavRow"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalOptions="Center"
                                Padding="4,0">
                        <HorizontalStackLayout x:Name="CarouselLayout"
                                               Spacing="4"
                                               VerticalOptions="Center"/>
                    </ScrollView>

                    <!-- Right arrow -->
                    <Border Grid.Column="4"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="8,4"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCarouselNextTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="›"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#9ca3af"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Border>

                    <!-- Hidden scan indicator (legacy refs, scan feedback now in header) -->
                    <Border x:Name="ScanIndicatorCard"
                            Grid.Column="5"
                            IsVisible="False"
                            HeightRequest="0"
                            WidthRequest="0">
                        <VerticalStackLayout>
                            <Label x:Name="ScanIndicatorLabel"/>
                            <Label x:Name="ScanIndicatorStatus"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- Divider between belt and tracking card -->
                <BoxView HeightRequest="1"
                         BackgroundColor="#e5e7eb"
                         Margin="8,0"
                         IsVisible="{Binding HasCurrentOrder}"/>

                <!-- Tracking card — bound to first result -->
                <Grid x:Name="TrackingCardSection"
                      IsVisible="{Binding HasCurrentOrder}"
                      ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="14"
                      RowDefinitions="Auto, Auto"
                      RowSpacing="4"
                      Padding="16,10,24,10">
                    <!-- Platform icon -->
                    <Image Grid.Column="0"
                           Grid.RowSpan="2"
                           Source="{Binding CurrentOrder.PlatformIcon}"
                           IsVisible="{Binding CurrentOrder.HasPlatformIcon}"
                           WidthRequest="44"
                           HeightRequest="44"
                           Aspect="AspectFit"
                           VerticalOptions="Center"/>
                    <!-- Tracking ID -->
                    <Label Grid.Column="1"
                           Grid.Row="0"
                           Text="{Binding CurrentOrder.TrackingNumber}"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="#111827"
                           VerticalOptions="Center"/>
                    <!-- Metadata row -->
                    <HorizontalStackLayout Grid.Column="1"
                                           Grid.Row="1"
                                           Spacing="16"
                                           VerticalOptions="Center">
                        <Label FontSize="11"
                               TextColor="#6b7280">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Order: "
                                          TextColor="#9ca3af"/>
                                    <Span Text="{Binding CurrentOrder.OrderNumber}"
                                          TextColor="#374151"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label FontSize="11"
                               TextColor="#6b7280">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Items: "
                                          TextColor="#9ca3af"/>
                                    <Span Text="{Binding CurrentOrder.TotalItemsDisplay}"
                                          TextColor="#374151"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label FontSize="11"
                               TextColor="#6b7280">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Packed: "
                                          TextColor="#9ca3af"/>
                                    <Span Text="{Binding CurrentOrder.PackedByDisplay}"
                                          TextColor="#374151"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label FontSize="11"
                               TextColor="#6b7280">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Checked: "
                                          TextColor="#9ca3af"/>
                                    <Span Text="{Binding CurrentOrder.CheckedByDisplay}"
                                          TextColor="#374151"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label FontSize="11"
                               TextColor="#9ca3af">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Submitted: "/>
                                    <Span Text="{Binding CurrentOrder.CreatedAtDisplay}"
                                          TextColor="#6b7280"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>
                    <!-- Status badges -->
                    <HorizontalStackLayout Grid.Column="2"
                                           Grid.RowSpan="2"
                                           Spacing="4"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End">
                        <Border BackgroundColor="{Binding CurrentOrder.StatusBgColor}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 4"
                                Padding="10,5">
                            <Label Text="{Binding CurrentOrder.StatusDisplay}"
                                   TextColor="{Binding CurrentOrder.StatusFgColor}"
                                   FontSize="15"
                                   FontAttributes="Bold"/>
                        </Border>

                        <Border IsVisible="{Binding CurrentOrder.IsPackedComplete}"
                                BackgroundColor="#dcfce7"
                                Stroke="#86efac"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 4"
                                Padding="10,5">
                            <Label Text="✓ QC Passed"
                                   TextColor="#166534"
                                   FontSize="15"
                                   FontAttributes="Bold"/>
                        </Border>
                        <Border x:Name="ResetButton"
                                IsVisible="False"
                                BackgroundColor="#fef2f2"
                                Stroke="#fecaca"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 4"
                                Padding="10,5"
                                ToolTipProperties.Text="Reset QC status and quantities"
                                Style="{StaticResource HoverButton}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnResetButtonTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="↺ Reset"
                                   TextColor="#dc2626"
                                   FontSize="13"
                                   FontAttributes="Bold"/>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- Content row: main results -->
        <Grid Grid.Row="3"
              BackgroundColor="#f3f4f6">

        <!-- Scrollable results -->
        <ScrollView x:Name="ResultsScroll"
                    Grid.Column="0"
                    BackgroundColor="#f3f4f6">
            <VerticalStackLayout Padding="0"
                                 Spacing="0">

                <!-- Not-found card -->
                <Border x:Name="NotFoundCard"
                        IsVisible="False"
                        Stroke="#d1d5db"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="White"
                        Padding="24"
                        Margin="0,16,0,0">
                    <Label x:Name="NotFoundLabel"
                           Text=""
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#111827"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </Border>

                <CollectionView x:Name="ResultsView"
                                ItemsSource="{Binding ActiveResults}"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PackingList">
                            <VerticalStackLayout Spacing="6"
                                                 Margin="0,16,0,0">

                                <!-- Individual product rows -->
                                <VerticalStackLayout IsVisible="{Binding HasProducts}"
                                                     BindableLayout.ItemsSource="{Binding ParsedProducts}"
                                                     Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProductItem">
                                            <VerticalStackLayout Spacing="0">

                                            <!-- === STANDARD PRODUCT ROW (Active/Unverified) === -->
                                            <Border IsVisible="{Binding IsNotBundle}"
                                                    BackgroundColor="{Binding CardBgColor}"
                                                    Stroke="{Binding CardBorderColor}"
                                                    StrokeThickness="{Binding CardBorderWidth}"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding ShowCompletedCheck}"
                                                                 Value="True">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.Shadow>
                                                    <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.05"/>
                                                </Border.Shadow>
                                                <Border.GestureRecognizers>
                                                    <PointerGestureRecognizer PointerEntered="OnProductCardEntered"
                                                                              PointerExited="OnProductCardExited"/>
                                                    <TapGestureRecognizer Tapped="OnProductRowTapped"/>
                                                </Border.GestureRecognizers>

                                                <Grid ColumnDefinitions="4, Auto, *, Auto"
                                                      Padding="0,16,24,16">

                                                        <!-- Col 0: Status strip -->
                                                        <BoxView Grid.Column="0" Grid.RowSpan="2"
                                                                 WidthRequest="4"
                                                                 BackgroundColor="{Binding StripColor}"
                                                                 VerticalOptions="Fill"/>

                                                        <!-- Col 1: 300x300 image with index badge overlay -->
                                                        <Grid Grid.Column="1"
                                                              Margin="16,0,20,0"
                                                              VerticalOptions="Center">
                                                            <Border StrokeShape="RoundRectangle 8"
                                                                    Stroke="{Binding CardBorderColor}"
                                                                    StrokeThickness="0"
                                                                    BackgroundColor="#f3f4f6"
                                                                    Padding="0"
                                                                    WidthRequest="250" HeightRequest="250">
                                                                <Image Source="{Binding LocalImagePath}"
                                                                       IsVisible="{Binding HasLocalImage}"
                                                                       HeightRequest="250" WidthRequest="250"
                                                                       Aspect="AspectFill"/>
                                                            </Border>
                                                            <Border StrokeShape="RoundRectangle 8"
                                                                    Stroke="{Binding CardBorderColor}"
                                                                    StrokeThickness="0"
                                                                    BackgroundColor="#f3f4f6"
                                                                    Padding="0"
                                                                    WidthRequest="250" HeightRequest="250"
                                                                    IsVisible="{Binding HasNoLocalImage}">
                                                                <Image Source="{Binding ImageSource}"
                                                                       IsVisible="{Binding HasImage}"
                                                                       HeightRequest="250" WidthRequest="250"
                                                                       Aspect="AspectFill"/>
                                                            </Border>

                                                            <!-- Index badge (top-left) -->
                                                            <Border HorizontalOptions="Start"
                                                                    VerticalOptions="Start"
                                                                    BackgroundColor="#334155"
                                                                    Stroke="Transparent"
                                                                    StrokeShape="RoundRectangle 6"
                                                                    Padding="6,3,8,3"
                                                                    Margin="12,4">
                                                                <Label Text="{Binding RowNumber, StringFormat='#{0}'}"
                                                                       FontSize="13"
                                                                       FontAttributes="Bold"
                                                                       TextColor="White"
                                                                       FontFamily="Consolas"/>
                                                            </Border>

                                                        </Grid>

                                                        <!-- Col 2: Info column -->
                                                        <VerticalStackLayout Grid.Column="2"
                                                                             Spacing="12"
                                                                             VerticalOptions="Center"
                                                                             Padding="0,0,16,0">
                                                            <!-- Product name (single line, ellipsis) -->
                                                            <Label Text="{Binding BaseName}"
                                                                   FontSize="22"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{Binding CardTextColor}"
                                                                   LineBreakMode="TailTruncation"
                                                                   MaxLines="1"/>

                                                            <!-- SKU pills -->
                                                            <FlexLayout Direction="Row" Wrap="Wrap"
                                                                        AlignItems="Center"
                                                                        IsVisible="{Binding HasSkuPills}"
                                                                        BindableLayout.ItemsSource="{Binding SkuPillSkus}">
                                                                <BindableLayout.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Border Padding="10,4"
                                                                                Margin="0,0,6,6"
                                                                                StrokeShape="RoundRectangle 6"
                                                                                StrokeThickness="1"
                                                                                BackgroundColor="{Binding Source={RelativeSource AncestorType={x:Type models:ProductItem}}, Path=SkuPillBg}"
                                                                                Stroke="{Binding Source={RelativeSource AncestorType={x:Type models:ProductItem}}, Path=SkuPillBorder}">
                                                                            <Label Text="{Binding .}"
                                                                                   FontSize="16"
                                                                                   FontFamily="Consolas"
                                                                                   FontAttributes="Bold"
                                                                                   TextColor="{Binding Source={RelativeSource AncestorType={x:Type models:ProductItem}}, Path=SkuPillText}"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </BindableLayout.ItemTemplate>
                                                            </FlexLayout>
                                                            <Label Text="{Binding SellerSku}"
                                                                   IsVisible="{Binding HasNoSkuPills}"
                                                                   FontSize="16"
                                                                   FontFamily="Consolas"
                                                                   TextColor="#9ca3af"/>

                                                            <!-- Variation badge -->
                                                            <Border IsVisible="{Binding HasVariation}"
                                                                    BackgroundColor="{Binding VariationBadgeBg}"
                                                                    Stroke="{Binding VariationBorderColor}"
                                                                    StrokeThickness="1.5"
                                                                    StrokeShape="RoundRectangle 8"
                                                                    Padding="12,6"
                                                                    HorizontalOptions="Start">
                                                                <HorizontalStackLayout Spacing="6">
                                                                    <BoxView IsVisible="{Binding HasSwatch}"
                                                                             Color="{Binding SwatchColor}"
                                                                             WidthRequest="18"
                                                                             HeightRequest="18"
                                                                             CornerRadius="4"
                                                                             VerticalOptions="Center"/>
                                                                    <BoxView IsVisible="{Binding HasSwatch2}"
                                                                             Color="{Binding SwatchColor2}"
                                                                             WidthRequest="18"
                                                                             HeightRequest="18"
                                                                             CornerRadius="4"
                                                                             VerticalOptions="Center"/>
                                                                    <Label Text="{Binding Variation}"
                                                                           FontSize="16"
                                                                           TextColor="{Binding VariationBadgeTextColor}"
                                                                           VerticalOptions="Center"
                                                                           LineBreakMode="TailTruncation"
                                                                           MaxLines="1"/>
                                                                </HorizontalStackLayout>
                                                            </Border>

                                                            <!-- QC Notes (inline) -->
                                                            <Border IsVisible="{Binding HasQcNotes}"
                                                                    BackgroundColor="#fffbeb"
                                                                    Stroke="#fbbf24"
                                                                    StrokeThickness="1"
                                                                    StrokeShape="RoundRectangle 8"
                                                                    Padding="12,8"
                                                                    HorizontalOptions="Start">
                                                                <Label TextColor="#b45309"
                                                                       FontSize="15"
                                                                       LineBreakMode="WordWrap"
                                                                       MaxLines="3">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="📢 QC: "
                                                                                  FontAttributes="Bold"
                                                                                  FontSize="15"/>
                                                                            <Span Text="{Binding QcNotes}"
                                                                                  FontSize="15"
                                                                                  FontAttributes="Bold"/>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>
                                                            </Border>
                                                        </VerticalStackLayout>

                                                        <!-- Col 3: Qty counter pinned right -->
                                                        <Border Grid.Column="3"
                                                                BackgroundColor="{Binding ButtonBgColor}"
                                                                Stroke="{Binding CardBorderColor}"
                                                                StrokeThickness="2"
                                                                StrokeShape="RoundRectangle 12"
                                                                Padding="24,16"
                                                                VerticalOptions="Center"
                                                                MinimumWidthRequest="100">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnQuantityTapped"/>
                                                            </Border.GestureRecognizers>
                                                            <HorizontalStackLayout HorizontalOptions="Center"
                                                                                   Spacing="4">
                                                                <Label Text="{Binding VerifiedQuantity}"
                                                                       FontSize="32"
                                                                       FontAttributes="Bold"
                                                                       TextColor="{Binding ButtonTextColor}"
                                                                       FontFamily="Consolas"/>
                                                                <Label Text="/"
                                                                       FontSize="22"
                                                                       TextColor="#d1d5db"
                                                                       FontFamily="Consolas"
                                                                       VerticalOptions="Center"/>
                                                                <Label Text="{Binding RequiredQuantity}"
                                                                       FontSize="22"
                                                                       TextColor="#9ca3af"
                                                                       FontFamily="Consolas"
                                                                       VerticalOptions="Center"/>
                                                            </HorizontalStackLayout>
                                                        </Border>
                                                    </Grid>
                                            </Border>

                                            <!-- === STANDARD COMPACT ROW (Verified/Completed) === -->
                                            <Border IsVisible="{Binding IsNotBundle}"
                                                    BackgroundColor="#ECFDF5"
                                                    Stroke="#86efac"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding ShowRowNumber}"
                                                                 Value="True">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </DataTrigger>
                                                    <!-- Active (scan/nav) overrides the verified-green border with purple -->
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsActive}"
                                                                 Value="True">
                                                        <Setter Property="Stroke" Value="#a78bfa"/>
                                                        <Setter Property="StrokeThickness" Value="3"/>
                                                        <Setter Property="BackgroundColor" Value="#F5F3FF"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <PointerGestureRecognizer PointerEntered="OnProductCardEntered"
                                                                              PointerExited="OnProductCardExited"/>
                                                    <TapGestureRecognizer Tapped="OnProductRowTapped"/>
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="4, 145, *, Auto"
                                                      Padding="0,8,16,8">
                                                    <BoxView Grid.Column="0"
                                                             WidthRequest="4"
                                                             BackgroundColor="#86efac"
                                                             VerticalOptions="Fill"/>
                                                    <Grid Grid.Column="1" Padding="10,0">
                                                        <Image Source="{Binding LocalImagePath}"
                                                               IsVisible="{Binding HasLocalImage}"
                                                               HeightRequest="125"
                                                               WidthRequest="125"
                                                               Aspect="AspectFill"/>
                                                        <Image Source="{Binding ImageSource}"
                                                               IsVisible="{Binding HasNoLocalImage}"
                                                               HeightRequest="125"
                                                               WidthRequest="125"
                                                               Aspect="AspectFill"/>
                                                        <Label Text="✓"
                                                               FontSize="20"
                                                               FontAttributes="Bold"
                                                               TextColor="#16a34a"
                                                               HorizontalOptions="End"
                                                               VerticalOptions="End"
                                                               Margin="0,0,2,0"/>
                                                    </Grid>
                                                    <VerticalStackLayout Grid.Column="2"
                                                                         VerticalOptions="Center"
                                                                         Spacing="4"
                                                                         Padding="4,0">
                                                        <Label Text="{Binding BaseName}"
                                                               FontSize="15"
                                                               FontAttributes="Bold"
                                                               TextColor="#166534"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1"/>
                                                        <HorizontalStackLayout Spacing="8">
                                                            <Border IsVisible="{Binding HasVariation}"
                                                                    BackgroundColor="#d1fae5"
                                                                    Stroke="#86efac"
                                                                    StrokeThickness="1"
                                                                    StrokeShape="RoundRectangle 6"
                                                                    Padding="8,3"
                                                                    VerticalOptions="Center">
                                                                <Label Text="{Binding Variation}"
                                                                       FontSize="12"
                                                                       FontAttributes="Bold"
                                                                       TextColor="#166534"/>
                                                            </Border>
                                                        </HorizontalStackLayout>
                                                        <Border IsVisible="{Binding HasQcNotes}"
                                                                BackgroundColor="#fffbeb"
                                                                Stroke="#fbbf24"
                                                                StrokeThickness="1"
                                                                StrokeShape="RoundRectangle 6"
                                                                Padding="8,3"
                                                                HorizontalOptions="Start">
                                                            <Label TextColor="#b45309" FontSize="12" FontAttributes="Bold"
                                                                   LineBreakMode="TailTruncation" MaxLines="1">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="📢 QC: " FontAttributes="Bold" FontSize="12"/>
                                                                        <Span Text="{Binding QcNotes}" FontAttributes="Bold" FontSize="12"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                        </Border>
                                                    </VerticalStackLayout>
                                                    <Border Grid.Column="3"
                                                            BackgroundColor="#dcfce7"
                                                            Stroke="#86efac"
                                                            StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 6"
                                                            Padding="12,6"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding CompletedQtyText}"
                                                               FontSize="15"
                                                               FontAttributes="Bold"
                                                               TextColor="#166534"
                                                               FontFamily="Consolas"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- === BUNDLE PARENT ROW (Active/Unverified) === -->
                                            <Border IsVisible="{Binding IsBundle}"
                                                    BackgroundColor="{Binding CardBgColor}"
                                                    Stroke="{Binding CardBorderColor}"
                                                    StrokeThickness="{Binding CardBorderWidth}"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding ShowCompletedCheck}"
                                                                 Value="True">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.Shadow>
                                                    <Shadow Brush="Black" Offset="0,4" Radius="6" Opacity="0.05"/>
                                                </Border.Shadow>
                                                <Border.GestureRecognizers>
                                                    <PointerGestureRecognizer PointerEntered="OnProductCardEntered"
                                                                              PointerExited="OnProductCardExited"/>
                                                    <TapGestureRecognizer Tapped="OnProductRowTapped"/>
                                                </Border.GestureRecognizers>

                                                <Grid ColumnDefinitions="4, Auto, *, Auto"
                                                      Padding="0,16,24,16">

                                                    <!-- Col 0: Status strip -->
                                                    <BoxView Grid.Column="0"
                                                             WidthRequest="4"
                                                             BackgroundColor="{Binding StripColor}"
                                                             VerticalOptions="Fill"/>

                                                    <!-- Col 1: 300x300 image with badges -->
                                                    <Grid Grid.Column="1"
                                                          Margin="16,0,20,0"
                                                          VerticalOptions="Center">
                                                        <Border StrokeShape="RoundRectangle 8"
                                                                Stroke="{Binding CardBorderColor}"
                                                                StrokeThickness="0"
                                                                BackgroundColor="#f3f4f6"
                                                                Padding="0"
                                                                WidthRequest="250" HeightRequest="250">
                                                            <Image Source="{Binding LocalImagePath}"
                                                                   IsVisible="{Binding HasLocalImage}"
                                                                   HeightRequest="250" WidthRequest="250"
                                                                   Aspect="AspectFill"/>
                                                        </Border>
                                                        <Border StrokeShape="RoundRectangle 8"
                                                                Stroke="{Binding CardBorderColor}"
                                                                StrokeThickness="0"
                                                                BackgroundColor="#f3f4f6"
                                                                Padding="0"
                                                                WidthRequest="250" HeightRequest="250"
                                                                IsVisible="{Binding HasNoLocalImage}">
                                                            <Image Source="{Binding ImageSource}"
                                                                   IsVisible="{Binding HasImage}"
                                                                   HeightRequest="250" WidthRequest="250"
                                                                   Aspect="AspectFill"/>
                                                        </Border>

                                                        <!-- Index badge + chevron (top-left) -->
                                                        <Border HorizontalOptions="Start"
                                                                VerticalOptions="Start"
                                                                BackgroundColor="#334155"
                                                                Stroke="Transparent"
                                                                StrokeShape="RoundRectangle 6"
                                                                Padding="6,3,8,3"
                                                                Margin="12,4">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnBundleChevronTapped"/>
                                                            </Border.GestureRecognizers>
                                                            <HorizontalStackLayout Spacing="3">
                                                                <Label Text="{Binding RowNumber, StringFormat='#{0}'}"
                                                                       FontSize="13"
                                                                       FontAttributes="Bold"
                                                                       TextColor="White"
                                                                       FontFamily="Consolas"/>
                                                                <Label Text="{Binding BundleChevron}"
                                                                       FontSize="10"
                                                                       TextColor="White"
                                                                       VerticalOptions="Center"/>
                                                            </HorizontalStackLayout>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Col 2: Info column -->
                                                    <VerticalStackLayout Grid.Column="2"
                                                                         Spacing="12"
                                                                         VerticalOptions="Center"
                                                                         Padding="0,0,16,0">
                                                        <!-- Product name -->
                                                        <Label Text="{Binding BaseName}"
                                                               FontSize="22"
                                                               FontAttributes="Bold"
                                                               TextColor="{Binding CardTextColor}"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1"/>

                                                        <!-- Bundle progress dots -->
                                                        <HorizontalStackLayout Spacing="6"
                                                                               IsVisible="{Binding HasBundleComponents}"
                                                                               BindableLayout.ItemsSource="{Binding BundleComponentDotColors}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="Color">
                                                                    <BoxView WidthRequest="14"
                                                                             HeightRequest="14"
                                                                             CornerRadius="7"
                                                                             Color="{Binding .}"/>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </HorizontalStackLayout>

                                                        <!-- SKU pills -->
                                                        <FlexLayout Direction="Row" Wrap="Wrap"
                                                                    AlignItems="Center"
                                                                    IsVisible="{Binding HasSkuPills}"
                                                                    BindableLayout.ItemsSource="{Binding SkuPillSkus}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Border Padding="10,4"
                                                                            Margin="0,0,6,6"
                                                                            StrokeShape="RoundRectangle 6"
                                                                            StrokeThickness="1"
                                                                            BackgroundColor="{Binding Source={RelativeSource AncestorType={x:Type models:ProductItem}}, Path=SkuPillBg}"
                                                                            Stroke="{Binding Source={RelativeSource AncestorType={x:Type models:ProductItem}}, Path=SkuPillBorder}">
                                                                        <Label Text="{Binding .}"
                                                                               FontSize="16"
                                                                               FontFamily="Consolas"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{Binding Source={RelativeSource AncestorType={x:Type models:ProductItem}}, Path=SkuPillText}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </FlexLayout>

                                                        <!-- Variation badge -->
                                                        <Border IsVisible="{Binding HasVariation}"
                                                                BackgroundColor="{Binding VariationBadgeBg}"
                                                                Stroke="{Binding VariationBorderColor}"
                                                                StrokeThickness="1.5"
                                                                StrokeShape="RoundRectangle 8"
                                                                Padding="12,6"
                                                                HorizontalOptions="Start">
                                                            <HorizontalStackLayout Spacing="6">
                                                                <BoxView IsVisible="{Binding HasSwatch}"
                                                                         Color="{Binding SwatchColor}"
                                                                         WidthRequest="18"
                                                                         HeightRequest="18"
                                                                         CornerRadius="4"
                                                                         VerticalOptions="Center"/>
                                                                <BoxView IsVisible="{Binding HasSwatch2}"
                                                                         Color="{Binding SwatchColor2}"
                                                                         WidthRequest="18"
                                                                         HeightRequest="18"
                                                                         CornerRadius="4"
                                                                         VerticalOptions="Center"/>
                                                                <Label Text="{Binding Variation}"
                                                                       FontSize="16"
                                                                       TextColor="{Binding VariationBadgeTextColor}"
                                                                       VerticalOptions="Center"
                                                                       LineBreakMode="TailTruncation"
                                                                       MaxLines="1"/>
                                                            </HorizontalStackLayout>
                                                        </Border>

                                                        <!-- Aggregated QC Notes (inline) -->
                                                        <Border IsVisible="{Binding HasAggregatedQcNotes}"
                                                                BackgroundColor="#fffbeb"
                                                                Stroke="#fbbf24"
                                                                StrokeThickness="1"
                                                                StrokeShape="RoundRectangle 8"
                                                                Padding="12,8"
                                                                HorizontalOptions="Start">
                                                            <Label TextColor="#b45309"
                                                                   FontSize="15"
                                                                   LineBreakMode="WordWrap"
                                                                   MaxLines="5">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="📢 QC: "
                                                                              FontAttributes="Bold"
                                                                              FontSize="15"/>
                                                                        <Span Text="{Binding AggregatedQcNotes}"
                                                                              FontSize="15"
                                                                              FontAttributes="Bold"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                        </Border>
                                                    </VerticalStackLayout>

                                                    <!-- Col 3: Qty counter pinned right -->
                                                    <Border Grid.Column="3"
                                                            BackgroundColor="{Binding ButtonBgColor}"
                                                            Stroke="{Binding CardBorderColor}"
                                                            StrokeThickness="2"
                                                            StrokeShape="RoundRectangle 12"
                                                            Padding="24,16"
                                                            VerticalOptions="Center"
                                                            MinimumWidthRequest="100">
                                                        <HorizontalStackLayout HorizontalOptions="Center"
                                                                               Spacing="4">
                                                            <Label Text="{Binding VerifiedQuantity}"
                                                                   FontSize="32"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{Binding ButtonTextColor}"
                                                                   FontFamily="Consolas"/>
                                                            <Label Text="/"
                                                                   FontSize="22"
                                                                   TextColor="#d1d5db"
                                                                   FontFamily="Consolas"
                                                                   VerticalOptions="Center"/>
                                                            <Label Text="{Binding RequiredQuantity}"
                                                                   FontSize="22"
                                                                   TextColor="#9ca3af"
                                                                   FontFamily="Consolas"
                                                                   VerticalOptions="Center"/>
                                                        </HorizontalStackLayout>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- === BUNDLE CHILD ROWS (sibling, not nested) === -->
                                            <VerticalStackLayout IsVisible="{Binding IsBundleExpanded}"
                                                                 BindableLayout.ItemsSource="{Binding BundleComponents}"
                                                                 Spacing="0"
                                                                 Margin="0,2,0,0">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:BundleComponentItem">
                                                      <VerticalStackLayout Spacing="0">

                                                        <!-- Full hero child (active/unverified) -->
                                                        <Border BackgroundColor="{Binding ComponentCardBg}"
                                                                Stroke="{Binding ComponentBorderColor}"
                                                                StrokeThickness="{Binding ComponentBorderWidth}"
                                                                StrokeShape="RoundRectangle 8"
                                                                Padding="0"
                                                                Margin="0,2,0,0">
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border"
                                                                             Binding="{Binding IsFullyVerified}"
                                                                             Value="True">
                                                                    <Setter Property="IsVisible" Value="False"/>
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnComponentRowTapped"/>
                                                            </Border.GestureRecognizers>

                                                            <Grid ColumnDefinitions="44, 20, Auto, *, Auto"
                                                                  Padding="0,12,24,12">

                                                                <!-- Col 0: Vertical tree line -->
                                                                <BoxView Grid.Column="0"
                                                                         WidthRequest="2"
                                                                         BackgroundColor="#94a3b8"
                                                                         HorizontalOptions="End"
                                                                         VerticalOptions="Fill"/>

                                                                <!-- Col 1: Horizontal connector -->
                                                                <BoxView Grid.Column="1"
                                                                         HeightRequest="2"
                                                                         BackgroundColor="#94a3b8"
                                                                         VerticalOptions="Center"
                                                                         HorizontalOptions="Fill"/>

                                                                <!-- Col 2: Child image (200x200, 0.8x of parent 250) -->
                                                                <Grid Grid.Column="2"
                                                                      Margin="8,0,16,0"
                                                                      VerticalOptions="Center">
                                                                    <Border StrokeShape="RoundRectangle 8"
                                                                            Stroke="{Binding ComponentBorderColor}"
                                                                            StrokeThickness="0"
                                                                            BackgroundColor="#f3f4f6"
                                                                            Padding="0"
                                                                            WidthRequest="200" HeightRequest="200">
                                                                        <Image Source="{Binding ImageSource}"
                                                                               IsVisible="{Binding HasImage}"
                                                                               HeightRequest="200" WidthRequest="200"
                                                                               Aspect="AspectFill"/>
                                                                    </Border>
                                                                    <Border StrokeShape="RoundRectangle 8"
                                                                            Stroke="{Binding ComponentBorderColor}"
                                                                            StrokeThickness="0"
                                                                            BackgroundColor="#f3f4f6"
                                                                            Padding="0"
                                                                            WidthRequest="200" HeightRequest="200"
                                                                            IsVisible="{Binding HasNoImage}">
                                                                        <Label Text="No Image" FontSize="14"
                                                                               TextColor="#94a3b8"
                                                                               HorizontalOptions="Center"
                                                                               VerticalOptions="Center"/>
                                                                    </Border>

                                                                    <!-- Sub-row badge (top-left) -->
                                                                    <Border HorizontalOptions="Start"
                                                                            VerticalOptions="Start"
                                                                            BackgroundColor="#6d28d9"
                                                                            Stroke="Transparent"
                                                                            StrokeShape="RoundRectangle 6"
                                                                            Padding="6,3,8,3"
                                                                            Margin="12,4">
                                                                        <Label Text="{Binding SubRowNumber, StringFormat='#{0}'}"
                                                                               FontSize="13"
                                                                               FontAttributes="Bold"
                                                                               TextColor="White"
                                                                               FontFamily="Consolas"/>
                                                                    </Border>
                                                                </Grid>

                                                                <!-- Col 3: Child info column -->
                                                                <VerticalStackLayout Grid.Column="3"
                                                                                     Spacing="12"
                                                                                     VerticalOptions="Center"
                                                                                     Padding="0,0,16,0">
                                                                    <Label Text="{Binding Name}"
                                                                           FontSize="22"
                                                                           FontAttributes="Bold"
                                                                           TextColor="#1f2937"
                                                                           LineBreakMode="TailTruncation"
                                                                           MaxLines="1">
                                                                        <Label.Triggers>
                                                                            <DataTrigger TargetType="Label"
                                                                                         Binding="{Binding IsFullyVerified}" Value="True">
                                                                                <Setter Property="TextColor" Value="#166534"/>
                                                                            </DataTrigger>
                                                                        </Label.Triggers>
                                                                    </Label>

                                                                    <FlexLayout Direction="Row" Wrap="Wrap"
                                                                                AlignItems="Center"
                                                                                IsVisible="{Binding HasSkuPills}"
                                                                                BindableLayout.ItemsSource="{Binding SkuPillSkus}">
                                                                        <BindableLayout.ItemTemplate>
                                                                            <DataTemplate x:DataType="x:String">
                                                                                <Border Padding="10,4"
                                                                                        Margin="0,0,6,6"
                                                                                        StrokeShape="RoundRectangle 6"
                                                                                        StrokeThickness="1"
                                                                                        BackgroundColor="{Binding Source={RelativeSource AncestorType={x:Type models:BundleComponentItem}}, Path=SkuPillBg}"
                                                                                        Stroke="{Binding Source={RelativeSource AncestorType={x:Type models:BundleComponentItem}}, Path=SkuPillBorder}">
                                                                                    <Label Text="{Binding .}"
                                                                                           FontSize="16"
                                                                                           FontFamily="Consolas"
                                                                                           FontAttributes="Bold"
                                                                                           TextColor="{Binding Source={RelativeSource AncestorType={x:Type models:BundleComponentItem}}, Path=SkuPillText}"/>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </BindableLayout.ItemTemplate>
                                                                    </FlexLayout>
                                                                    <Label Text="{Binding SellerSku}"
                                                                           IsVisible="{Binding HasNoSkuPills}"
                                                                           FontSize="16"
                                                                           FontFamily="Consolas"
                                                                           TextColor="#9ca3af"/>

                                                                    <Border IsVisible="{Binding HasVariation}"
                                                                            BackgroundColor="{Binding VariationBadgeBg}"
                                                                            Stroke="{Binding VariationBorderColor}"
                                                                            StrokeThickness="1.5"
                                                                            StrokeShape="RoundRectangle 8"
                                                                            Padding="12,6"
                                                                            HorizontalOptions="Start">
                                                                        <HorizontalStackLayout Spacing="6">
                                                                            <BoxView IsVisible="{Binding HasSwatch}"
                                                                                     Color="{Binding SwatchColor}"
                                                                                     WidthRequest="18"
                                                                                     HeightRequest="18"
                                                                                     CornerRadius="4"
                                                                                     VerticalOptions="Center"/>
                                                                            <BoxView IsVisible="{Binding HasSwatch2}"
                                                                                     Color="{Binding SwatchColor2}"
                                                                                     WidthRequest="18"
                                                                                     HeightRequest="18"
                                                                                     CornerRadius="4"
                                                                                     VerticalOptions="Center"/>
                                                                            <Label Text="{Binding Variation}"
                                                                                   FontSize="16"
                                                                                   TextColor="{Binding VariationBadgeTextColor}"
                                                                                   VerticalOptions="Center"
                                                                                   LineBreakMode="TailTruncation"
                                                                                   MaxLines="1"/>
                                                                        </HorizontalStackLayout>
                                                                    </Border>

                                                                    <!-- Child QC Notes (inline) -->
                                                                    <Border IsVisible="{Binding HasQcNotes}"
                                                                            BackgroundColor="#fffbeb"
                                                                            Stroke="#fbbf24"
                                                                            StrokeThickness="1"
                                                                            StrokeShape="RoundRectangle 8"
                                                                            Padding="12,8"
                                                                            HorizontalOptions="Start">
                                                                        <Label TextColor="#b45309"
                                                                               FontSize="15"
                                                                               LineBreakMode="WordWrap"
                                                                               MaxLines="3">
                                                                            <Label.FormattedText>
                                                                                <FormattedString>
                                                                                    <Span Text="📢 QC: "
                                                                                          FontAttributes="Bold"
                                                                                          FontSize="15"/>
                                                                                    <Span Text="{Binding QcNotes}"
                                                                                          FontSize="15"
                                                                                          FontAttributes="Bold"/>
                                                                                </FormattedString>
                                                                            </Label.FormattedText>
                                                                        </Label>
                                                                    </Border>
                                                                </VerticalStackLayout>

                                                                <!-- Col 4: Child qty counter -->
                                                                <Border Grid.Column="4"
                                                                        BackgroundColor="{Binding QtyBadgeBg}"
                                                                        Stroke="{Binding ComponentBorderColor}"
                                                                        StrokeThickness="2"
                                                                        StrokeShape="RoundRectangle 12"
                                                                        Padding="24,16"
                                                                        VerticalOptions="Center"
                                                                        MinimumWidthRequest="100">
                                                                    <HorizontalStackLayout HorizontalOptions="Center"
                                                                                           Spacing="4">
                                                                        <Label Text="{Binding VerifiedQuantity}"
                                                                               FontSize="32"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{Binding QtyTextColor}"
                                                                               FontFamily="Consolas"/>
                                                                        <Label Text="/"
                                                                               FontSize="22"
                                                                               TextColor="#d1d5db"
                                                                               FontFamily="Consolas"
                                                                               VerticalOptions="Center"/>
                                                                        <Label Text="{Binding RequiredQuantity}"
                                                                               FontSize="22"
                                                                               TextColor="#9ca3af"
                                                                               FontFamily="Consolas"
                                                                               VerticalOptions="Center"/>
                                                                    </HorizontalStackLayout>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Compact child (verified) — mirrors parent compact, keeps tree line, purple when active -->
                                                        <Border IsVisible="False"
                                                                BackgroundColor="{Binding ComponentCardBg}"
                                                                Stroke="{Binding ComponentBorderColor}"
                                                                StrokeThickness="{Binding ComponentBorderWidth}"
                                                                StrokeShape="RoundRectangle 8"
                                                                Padding="0"
                                                                Margin="0,2,0,0">
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border"
                                                                             Binding="{Binding IsFullyVerified}"
                                                                             Value="True">
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                </DataTrigger>
                                                                <!-- Active (UP/DOWN nav) overrides the verified-green border with purple -->
                                                                <DataTrigger TargetType="Border"
                                                                             Binding="{Binding IsActiveComponent}"
                                                                             Value="True">
                                                                    <Setter Property="Stroke" Value="#a78bfa"/>
                                                                    <Setter Property="StrokeThickness" Value="3"/>
                                                                    <Setter Property="BackgroundColor" Value="#F5F3FF"/>
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnComponentRowTapped"/>
                                                            </Border.GestureRecognizers>
                                                            <Grid ColumnDefinitions="44, 20, 145, *, Auto"
                                                                  Padding="0,8,16,8">
                                                                <BoxView Grid.Column="0" WidthRequest="2"
                                                                         BackgroundColor="{Binding ComponentBorderColor}"
                                                                         HorizontalOptions="End" VerticalOptions="Fill"/>
                                                                <BoxView Grid.Column="1" HeightRequest="2"
                                                                         BackgroundColor="{Binding ComponentBorderColor}"
                                                                         VerticalOptions="Center" HorizontalOptions="Fill"/>
                                                                <Grid Grid.Column="2" Padding="10,0">
                                                                    <Image Source="{Binding ImageSource}"
                                                                           IsVisible="{Binding HasImage}"
                                                                           HeightRequest="125" WidthRequest="125"
                                                                           Aspect="AspectFill"/>
                                                                    <Label Text="✓" FontSize="20" FontAttributes="Bold"
                                                                           TextColor="#16a34a"
                                                                           HorizontalOptions="End" VerticalOptions="End"
                                                                           Margin="0,0,2,0"/>
                                                                </Grid>
                                                                <VerticalStackLayout Grid.Column="3"
                                                                                     VerticalOptions="Center"
                                                                                     Spacing="4" Padding="4,0">
                                                                    <Label Text="{Binding Name}"
                                                                           FontSize="15" FontAttributes="Bold"
                                                                           TextColor="#166534"
                                                                           LineBreakMode="TailTruncation" MaxLines="1"/>
                                                                    <HorizontalStackLayout Spacing="8"
                                                                                           IsVisible="{Binding HasVariation}">
                                                                        <Border BackgroundColor="#d1fae5"
                                                                                Stroke="#86efac" StrokeThickness="1"
                                                                                StrokeShape="RoundRectangle 6"
                                                                                Padding="8,3" VerticalOptions="Center">
                                                                            <Label Text="{Binding Variation}"
                                                                                   FontSize="12" FontAttributes="Bold"
                                                                                   TextColor="#166534"/>
                                                                        </Border>
                                                                    </HorizontalStackLayout>
                                                                </VerticalStackLayout>
                                                                <Border Grid.Column="4"
                                                                        BackgroundColor="#dcfce7"
                                                                        Stroke="#86efac" StrokeThickness="1"
                                                                        StrokeShape="RoundRectangle 6"
                                                                        Padding="12,6" VerticalOptions="Center">
                                                                    <Label Text="{Binding ProgressText}"
                                                                           FontSize="15" FontAttributes="Bold"
                                                                           TextColor="#166534" FontFamily="Consolas"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                      </VerticalStackLayout>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                            <!-- === BUNDLE COMPACT ROW (Verified/Completed) === -->
                                            <Border IsVisible="{Binding IsBundle}"
                                                    BackgroundColor="#ECFDF5"
                                                    Stroke="#86efac"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding ShowRowNumber}"
                                                                 Value="True">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </DataTrigger>
                                                    <!-- Active (scan/nav) overrides the verified-green border with purple -->
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsActive}"
                                                                 Value="True">
                                                        <Setter Property="Stroke" Value="#a78bfa"/>
                                                        <Setter Property="StrokeThickness" Value="3"/>
                                                        <Setter Property="BackgroundColor" Value="#F5F3FF"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <PointerGestureRecognizer PointerEntered="OnProductCardEntered"
                                                                              PointerExited="OnProductCardExited"/>
                                                    <TapGestureRecognizer Tapped="OnProductRowTapped"/>
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="4, 145, *, Auto"
                                                      Padding="0,8,16,8">
                                                    <BoxView Grid.Column="0"
                                                             WidthRequest="4"
                                                             BackgroundColor="#a78bfa"
                                                             VerticalOptions="Fill"/>
                                                    <Grid Grid.Column="1" Padding="10,0">
                                                        <Image Source="{Binding LocalImagePath}"
                                                               IsVisible="{Binding HasLocalImage}"
                                                               HeightRequest="125"
                                                               WidthRequest="125"
                                                               Aspect="AspectFill"/>
                                                        <Image Source="{Binding ImageSource}"
                                                               IsVisible="{Binding HasNoLocalImage}"
                                                               HeightRequest="125"
                                                               WidthRequest="125"
                                                               Aspect="AspectFill"/>
                                                        <Label Text="✓"
                                                               FontSize="20"
                                                               FontAttributes="Bold"
                                                               TextColor="#16a34a"
                                                               HorizontalOptions="End"
                                                               VerticalOptions="End"
                                                               Margin="0,0,2,0"/>
                                                    </Grid>
                                                    <VerticalStackLayout Grid.Column="2"
                                                                         VerticalOptions="Center"
                                                                         Spacing="4"
                                                                         Padding="4,0">
                                                        <Label Text="{Binding BaseName}"
                                                               FontSize="15"
                                                               FontAttributes="Bold"
                                                               TextColor="#166534"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1"/>
                                                        <HorizontalStackLayout Spacing="8">
                                                            <Border IsVisible="{Binding HasVariation}"
                                                                    BackgroundColor="#d1fae5"
                                                                    Stroke="#86efac"
                                                                    StrokeThickness="1"
                                                                    StrokeShape="RoundRectangle 6"
                                                                    Padding="8,3"
                                                                    VerticalOptions="Center">
                                                                <Label Text="{Binding Variation}"
                                                                       FontSize="12"
                                                                       FontAttributes="Bold"
                                                                       TextColor="#166534"/>
                                                            </Border>
                                                        </HorizontalStackLayout>
                                                        <Border IsVisible="{Binding HasQcNotes}"
                                                                BackgroundColor="#fffbeb"
                                                                Stroke="#fbbf24"
                                                                StrokeThickness="1"
                                                                StrokeShape="RoundRectangle 6"
                                                                Padding="8,3"
                                                                HorizontalOptions="Start">
                                                            <Label TextColor="#b45309" FontSize="12" FontAttributes="Bold"
                                                                   LineBreakMode="TailTruncation" MaxLines="1">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="📢 QC: " FontAttributes="Bold" FontSize="12"/>
                                                                        <Span Text="{Binding QcNotes}" FontAttributes="Bold" FontSize="12"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                        </Border>
                                                    </VerticalStackLayout>
                                                    <Border Grid.Column="3"
                                                            BackgroundColor="#dcfce7"
                                                            Stroke="#86efac"
                                                            StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 6"
                                                            Padding="12,6"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding CompletedQtyText}"
                                                               FontSize="15"
                                                               FontAttributes="Bold"
                                                               TextColor="#166534"
                                                               FontFamily="Consolas"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        </Grid><!-- end content row wrapper -->

        <!-- ── Product image overlay (full-bleed split-pane modal) ── -->
        <Grid x:Name="ProductImageOverlay"
              Grid.Row="0"
              Grid.RowSpan="5"
              BackgroundColor="#99111827"
              IsVisible="False"
              ZIndex="8">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnImageOverlayBackdropTapped"/>
            </Grid.GestureRecognizers>

            <Grid ColumnDefinitions="0.15*, 0.7*, 0.15*" RowDefinitions="0.1*, 0.8*, 0.1*">
            <Border x:Name="OverlayCard"
                    Grid.Column="1"
                    Grid.Row="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 0"
                    BackgroundColor="White"
                    Padding="0"
                    Margin="0"
                    InputTransparent="False">
                <Border.Shadow>
                    <Shadow Brush="#50000000"
                            Offset="0,12"
                            Radius="40"/>
                </Border.Shadow>

                <Grid RowDefinitions="Auto, Auto, *"
                      ColumnDefinitions="*, *"
                      ColumnSpacing="0"
                      RowSpacing="0">

                    <!-- ── Top bar spanning both columns ── -->
                    <Grid Grid.Row="0"
                          Grid.ColumnSpan="2"
                          ColumnDefinitions="Auto, *, Auto"
                          BackgroundColor="#fafafa"
                          Padding="20,10">
                        <HorizontalStackLayout Grid.Column="0"
                                               Spacing="4"
                                               VerticalOptions="Center">
                            <Border BackgroundColor="#f3f4f6"
                                    Stroke="#e5e7eb"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 4"
                                    Padding="8,5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayPrevTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="&#x2190;"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#6b7280"/>
                            </Border>
                            <Border BackgroundColor="#f3f4f6"
                                    Stroke="#e5e7eb"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 4"
                                    Padding="8,5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayNextTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="&#x2192;"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#6b7280"/>
                            </Border>
                        </HorizontalStackLayout>
                        <Label x:Name="OverlayItemPosition"
                               Grid.Column="1"
                               Text="ITEM 01 of 01"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#9ca3af"
                               FontFamily="Consolas"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                            <Label x:Name="OverlayNavHint"
                                   Text="↑↓ navigate"
                                   FontSize="13"
                                   TextColor="#9ca3af"
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                            <Border BackgroundColor="#f3f4f6"
                                    Stroke="#e5e7eb"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 4"
                                    Padding="10,5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayCloseTapped"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="Esc"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#9ca3af"
                                           FontFamily="Consolas"
                                           VerticalOptions="Center"/>
                                    <Label Text="close"
                                           FontSize="13"
                                           TextColor="#d1d5db"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- ── Bundle header bar (visible only for bundles) ── -->
                    <Grid x:Name="OverlayBundleBar"
                          Grid.Row="1"
                          Grid.ColumnSpan="2"
                          IsVisible="False"
                          BackgroundColor="#ede9fe"
                          Padding="16,7"
                          ColumnDefinitions="Auto, *, Auto, Auto"
                          ColumnSpacing="8">
                        <Border Grid.Column="0"
                                BackgroundColor="#7c3aed"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 3"
                                Padding="7,2"
                                VerticalOptions="Center">
                            <Label Text="BUNDLE"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   FontFamily="Consolas"/>
                        </Border>
                        <Label x:Name="OverlayBundleBarName"
                               Grid.Column="1"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#3b0764"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation"/>
                        <HorizontalStackLayout x:Name="OverlayBundleStepDots"
                                               Grid.Column="2"
                                               Spacing="5"
                                               VerticalOptions="Center"/>
                        <Label x:Name="OverlayBundleBarCounter"
                               Grid.Column="3"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#5b21b6"
                               FontFamily="Consolas"
                               VerticalOptions="Center"/>
                    </Grid>
                    <BoxView x:Name="OverlayBundleBarLine"
                             Grid.Row="1"
                             Grid.ColumnSpan="2"
                             HeightRequest="2.5"
                             BackgroundColor="#7c3aed"
                             VerticalOptions="End"
                             IsVisible="False"/>

                    <!-- ── Left column: Reference image (khaki bg, full-bleed) ── -->
                    <Grid Grid.Row="2"
                          Grid.Column="0"
                          BackgroundColor="#E5E4C1"
                          Padding="0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOverlayImageTapped"/>
                        </Grid.GestureRecognizers>

                        <Image x:Name="OverlayImage"
                               Aspect="AspectFit"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"/>
                        <Label x:Name="OverlayNoImage"
                               Text="&#x1F4E6;"
                               FontSize="80"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="False"/>

                        <!-- Bottom bar: component name (left) + buttons (right) -->
                        <Grid ColumnDefinitions="*, Auto"
                              VerticalOptions="End"
                              Padding="16,0,16,16">
                            <Border x:Name="OverlayActiveCompLabel"
                                    Grid.Column="0"
                                    BackgroundColor="#99000000"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="10,4"
                                    HorizontalOptions="Start"
                                    VerticalOptions="End"
                                    Margin="0,0,12,0"
                                    IsVisible="False">
                                <Label x:Name="OverlayActiveCompText"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       FontFamily="Consolas"
                                       LineBreakMode="WordWrap"/>
                            </Border>
                            <HorizontalStackLayout Grid.Column="1"
                                                   VerticalOptions="End"
                                                   HorizontalOptions="End"
                                                   Spacing="8">
                            <Border x:Name="OverlayMinusBtn"
                                    BackgroundColor="#ef4444"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="20,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayMinusTapped"/>
                                </Border.GestureRecognizers>
                                <Border.Shadow>
                                    <Shadow Brush="#40000000"
                                            Offset="0,2"
                                            Radius="4"/>
                                </Border.Shadow>
                                <Label Text="−"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       FontFamily="Consolas"/>
                            </Border>
                            <Border x:Name="OverlayPlusBtn"
                                    BackgroundColor="#5B31E0"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="20,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayPlusTapped"/>
                                </Border.GestureRecognizers>
                                <Border.Shadow>
                                    <Shadow Brush="#40000000"
                                            Offset="0,2"
                                            Radius="4"/>
                                </Border.Shadow>
                                <Label Text="+"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       FontFamily="Consolas"/>
                            </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </Grid>

                    <!-- ── Right column: Details (white, 32px padding) ── -->
                    <VerticalStackLayout x:Name="OverlayStandardPanel"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Spacing="20"
                                         Padding="32"
                                         BackgroundColor="White">

                        <!-- Component hint (visible for bundle components) -->
                        <Border x:Name="OverlayComponentHint"
                                IsVisible="False"
                                BackgroundColor="#f5f3ff"
                                Stroke="#c4b5fd"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                Padding="10,6"
                                HorizontalOptions="Start"
                                Margin="0,0,0,-12">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="&#x1F4E6;"
                                       FontSize="16"
                                       VerticalOptions="Center"/>
                                <Label x:Name="OverlayComponentHintText"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#7c3aed"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- SCANNED label -->
                        <Label Text="SCANNED"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#6b7280"
                               FontFamily="Consolas"/>

                        <!-- Large counter: verified / required (tap to enter qty manually) -->
                        <HorizontalStackLayout HorizontalOptions="Start"
                                               Spacing="4"
                                               VerticalOptions="Center"
                                               Margin="0,-12,0,0">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOverlayQtyTapped"/>
                            </HorizontalStackLayout.GestureRecognizers>
                            <!-- Inline edit entry (shown when picking) -->
                            <Entry x:Name="OverlayPickEntry"
                                   IsVisible="False"
                                   Keyboard="Numeric"
                                   WidthRequest="96"
                                   FontSize="72"
                                   FontAttributes="Bold"
                                   FontFamily="Consolas"
                                   HorizontalTextAlignment="Center"
                                   ReturnType="Done"
                                   Completed="OnOverlayPickEntryCompleted"
                                   TextChanged="OnOverlayPickEntryTextChanged"
                                   VerticalOptions="Center"
                                   BackgroundColor="Transparent"/>
                            <!-- Read-only verified label (hidden when picking) -->
                            <Label x:Name="OverlayVerifiedQty"
                                   Text="0"
                                   FontSize="72"
                                   FontAttributes="Bold"
                                   TextColor="#111827"
                                   FontFamily="Consolas"
                                   VerticalOptions="Center"/>
                            <Label Text="/"
                                   FontSize="42"
                                   TextColor="#d1d5db"
                                   FontFamily="Consolas"
                                   VerticalOptions="Center"/>
                            <Label x:Name="OverlayReqQty"
                                   Text="1"
                                   FontSize="42"
                                   TextColor="#9ca3af"
                                   FontFamily="Consolas"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- Divider -->
                        <BoxView HeightRequest="1"
                                 BackgroundColor="#f3f4f6"/>

                        <!-- Product name -->
                        <Label x:Name="OverlayProductName"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#111827"
                               LineBreakMode="WordWrap"/>

                        <!-- SKU pills -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="SKU"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#6b7280"
                                   FontFamily="Consolas"/>
                            <FlexLayout x:Name="OverlaySkuPills"
                                        Wrap="Wrap"
                                        AlignItems="Center"
                                        JustifyContent="Start"/>
                        </VerticalStackLayout>

                        <!-- Variation pill badge (light purple) -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="VARIATION"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#6b7280"
                                   FontFamily="Consolas"/>
                            <Border x:Name="OverlayVariationBorder"
                                    BackgroundColor="#F5F3FF"
                                    Stroke="Transparent"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="14,6"
                                    HorizontalOptions="Start"
                                    IsVisible="False">
                                <HorizontalStackLayout Spacing="7">
                                    <BoxView x:Name="OverlayVariationSwatch"
                                             WidthRequest="22"
                                             HeightRequest="22"
                                             CornerRadius="5"
                                             VerticalOptions="Center"
                                             IsVisible="False"/>
                                    <BoxView x:Name="OverlayVariationSwatch2"
                                             WidthRequest="22"
                                             HeightRequest="22"
                                             CornerRadius="5"
                                             VerticalOptions="Center"
                                             IsVisible="False"/>
                                    <Label x:Name="OverlayVariationLabel"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#5b21b6"
                                           FontFamily="Consolas"/>
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- QC Notes -->
                        <VerticalStackLayout Spacing="4"
                                             VerticalOptions="FillAndExpand">
                            <Label Text="QC NOTES"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#6b7280"
                                   FontFamily="Consolas"/>
                            <Border x:Name="OverlayNotesBorder"
                                    BackgroundColor="#fffbeb"
                                    Stroke="#fbbf24"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="16,12"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="FillAndExpand">
                                <Label x:Name="OverlayNotesLabel"
                                       Text="📢 QC: no notes"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#b45309"
                                       VerticalTextAlignment="Start"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="FillAndExpand"
                                       LineBreakMode="WordWrap"/>
                            </Border>
                        </VerticalStackLayout>


                    </VerticalStackLayout>

                </Grid>
            </Border>
            </Grid>
        </Grid>

        <!-- ── QC Completion Summary popup ── -->
        <Grid x:Name="CompletionSummaryOverlay"
              Grid.Row="0"
              Grid.RowSpan="5"
              BackgroundColor="#99111827"
              IsVisible="False"
              ZIndex="9">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCompletionSummaryBackdropTapped"/>
            </Grid.GestureRecognizers>
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="White"
                    Padding="48,40"
                    WidthRequest="360"
                    InputTransparent="False">
                <Border.Shadow>
                    <Shadow Brush="#30000000"
                            Offset="0,12"
                            Radius="32"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="12"
                                     HorizontalOptions="Center">
                    <Border BackgroundColor="#dcfce7"
                            Stroke="#86efac"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 40"
                            WidthRequest="80"
                            HeightRequest="80"
                            HorizontalOptions="Center">
                        <Label Text="&#x2713;"
                               FontSize="40"
                               FontAttributes="Bold"
                               TextColor="#16a34a"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Border>
                    <Label x:Name="CompletionCountLabel"
                           Text="0"
                           FontSize="56"
                           FontAttributes="Bold"
                           TextColor="#111827"
                           HorizontalTextAlignment="Center"/>
                    <BoxView HeightRequest="1"
                             BackgroundColor="#e5e7eb"
                             Margin="20,0"/>
                    <Label Text="ITEMS COMPLETE"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#6b7280"
                           CharacterSpacing="4"
                           HorizontalTextAlignment="Center"/>
                    <Grid HeightRequest="6"
                          WidthRequest="240"
                          HorizontalOptions="Center"
                          Margin="0,8,0,0">
                        <BoxView BackgroundColor="#e5e7eb"
                                 CornerRadius="3"/>
                        <BoxView x:Name="CompletionProgressBar"
                                 BackgroundColor="#16a34a"
                                 CornerRadius="3"
                                 HorizontalOptions="Start"
                                 WidthRequest="240"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ── Cancelled-order overlay — shown when a cancelled order loads; manual dismiss only ── -->
        <Grid x:Name="CancelledOrderOverlay"
              Grid.Row="0"
              Grid.RowSpan="5"
              BackgroundColor="#99111827"
              IsVisible="False"
              ZIndex="11">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCancelledOverlayBackdropTapped"/>
            </Grid.GestureRecognizers>
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="White"
                    Padding="48,40"
                    WidthRequest="380"
                    InputTransparent="False">
                <Border.Shadow>
                    <Shadow Brush="#30000000" Offset="0,12" Radius="32"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Border BackgroundColor="#fee2e2" Stroke="Transparent" StrokeShape="RoundRectangle 999"
                            WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                        <Label Text="&#x2715;" FontSize="30" FontAttributes="Bold" TextColor="#b91c1c"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    </Border>
                    <Label Text="{Binding CurrentOrder.OrderStatusDisplay}"
                           FontSize="28" FontAttributes="Bold" TextColor="#b91c1c"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="คำสั่งซื้อนี้ถูกยกเลิก"
                           FontSize="15" TextColor="#6b7280"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding CurrentOrder.TrackingNumber}"
                           FontSize="13" TextColor="#9ca3af"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Border BackgroundColor="#b91c1c" Stroke="Transparent" StrokeShape="RoundRectangle 8"
                            Padding="28,10" HorizontalOptions="Center" Margin="0,6,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelledOverlayDismissTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="ปิด" FontSize="15" FontAttributes="Bold" TextColor="White"
                               HorizontalTextAlignment="Center"/>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ── Command Palette search (centered, 70% width, soft shadow) ── -->
        <Border x:Name="PopupSearchBar"
                Grid.Row="1"
                Grid.RowSpan="3"
                Grid.ColumnSpan="3"
                IsVisible="False"
                ZIndex="15"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                BackgroundColor="White"
                Stroke="Transparent"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Margin="0,48,0,0"
                Padding="0"
                WidthRequest="800"
                InputTransparent="False">
            <Border.Shadow>
                <Shadow Brush="#30000000"
                        Offset="0,8"
                        Radius="32"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="12"
                      Padding="16,14"
                      VerticalOptions="Center">
                    <!-- "/" keycap icon -->
                    <Border Grid.Column="0"
                            BackgroundColor="#f4f4f5"
                            Stroke="#e5e7eb"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4"
                            Padding="6,4"
                            VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#33000000"
                                    Offset="0,2"
                                    Radius="0"/>
                        </Border.Shadow>
                        <Label Text="/"
                               TextColor="#71717a"
                               FontSize="14"
                               FontAttributes="Bold"
                               FontFamily="Consolas"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Border>
                    <!-- Search entry (monospace placeholder) -->
                    <Entry x:Name="PopupSearchEntry"
                           Grid.Column="1"
                           Placeholder="Tracking or order number…"
                           PlaceholderColor="#a1a1aa"
                           TextColor="#111827"
                           FontSize="16"
                           FontFamily="Consolas"
                           BackgroundColor="Transparent"
                           ReturnType="Search"
                           Completed="OnPopupSearchCommitted"
                           VerticalOptions="Center"/>
                    <!-- Hint text -->
                    <Label Grid.Column="2"
                           Text="Esc to close · Enter to search"
                           TextColor="#a1a1aa"
                           FontSize="11"
                           VerticalOptions="Center"/>
                </Grid>
                <!-- Decorative accent line -->
                <BoxView HeightRequest="1"
                         BackgroundColor="#D8B4FE"
                         Margin="16,0"/>
            </VerticalStackLayout>
        </Border>

        <!-- Backdrop to catch clicks outside the popup search bar -->
        <Grid x:Name="PopupSearchBackdrop"
              Grid.Row="1"
              Grid.RowSpan="4"
              BackgroundColor="#40000000"
              IsVisible="False"
              ZIndex="14"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPopupSearchBackdropTapped"/>
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Welcome animation banner — briefly shown after login -->
        <Border x:Name="WelcomeBanner"
                Grid.Row="1"
                Grid.RowSpan="4"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="#1e3a5f"
                Stroke="#3b82f6"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="36,22"
                InputTransparent="True"
                ZIndex="9">
            <Label x:Name="WelcomeLabel"
                   Text=""
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>
        </Border>

        <!-- ── Bottom keyboard shortcuts bar ── -->
        <Border Grid.Row="4"
                BackgroundColor="#f9fafb"
                Stroke="#e5e7eb"
                StrokeThickness="1"
                Padding="16,6">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <!-- QC mode shortcuts -->
                <HorizontalStackLayout x:Name="QcShortcuts"
                                       Grid.Column="0"
                                       Spacing="20"
                                       VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="4">
                        <Border BackgroundColor="#e5e7eb"
                                StrokeShape="RoundRectangle 3"
                                Padding="4,2"
                                Stroke="Transparent">
                            <Label Text="&#x2191;&#x2193;"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#374151"/>
                        </Border>
                        <Label Text="products"
                               FontSize="10"
                               TextColor="#6b7280"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Border BackgroundColor="#e5e7eb"
                                StrokeShape="RoundRectangle 3"
                                Padding="4,2"
                                Stroke="Transparent">
                            <Label Text="&#x2190;&#x2192;"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#374151"/>
                        </Border>
                        <Label Text="history"
                               FontSize="10"
                               TextColor="#6b7280"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Border BackgroundColor="#e5e7eb"
                                StrokeShape="RoundRectangle 3"
                                Padding="4,2"
                                Stroke="Transparent">
                            <Label Text="+ / −"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#374151"/>
                        </Border>
                        <Label Text="verify"
                               FontSize="10"
                               TextColor="#6b7280"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Border BackgroundColor="#e5e7eb"
                                StrokeShape="RoundRectangle 3"
                                Padding="4,2"
                                Stroke="Transparent">
                            <Label Text="0-9"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#374151"/>
                        </Border>
                        <Label Text="edit qty"
                               FontSize="10"
                               TextColor="#6b7280"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Border BackgroundColor="#e5e7eb"
                                StrokeShape="RoundRectangle 3"
                                Padding="4,2"
                                Stroke="Transparent">
                            <Label Text="I"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#374151"/>
                        </Border>
                        <Label Text="peek image"
                               FontSize="10"
                               TextColor="#6b7280"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Border BackgroundColor="#e5e7eb"
                                StrokeShape="RoundRectangle 3"
                                Padding="4,2"
                                Stroke="Transparent">
                            <Label Text="/"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#374151"/>
                        </Border>
                        <Label Text="search"
                               FontSize="10"
                               TextColor="#6b7280"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Border BackgroundColor="#e5e7eb"
                                StrokeShape="RoundRectangle 3"
                                Padding="4,2"
                                Stroke="Transparent">
                            <Label Text="Esc"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#374151"/>
                        </Border>
                        <Label Text="close peek"
                               FontSize="10"
                               TextColor="#6b7280"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Border BackgroundColor="#e5e7eb"
                                StrokeShape="RoundRectangle 3"
                                Padding="4,2"
                                Stroke="Transparent">
                            <Label Text="click row"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#374151"/>
                        </Border>
                        <Label Text="peek"
                               FontSize="10"
                               TextColor="#6b7280"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
                <Label x:Name="StatusLabel"
                       Grid.Column="1"
                       Text=""
                       FontSize="11"
                       TextColor="#6b7280"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       Margin="0,0,12,0"/>
                <Label x:Name="LastScanLabel"
                       Grid.Column="2"
                       Text=""
                       FontSize="10"
                       TextColor="#9ca3af"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Login overlay — dark blur-like backdrop until operator scans badge -->
        <Grid x:Name="LoginOverlay"
              Grid.Row="1"
              Grid.RowSpan="4"
              BackgroundColor="#CC111827"
              IsVisible="True"
              ZIndex="10">
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="#374151"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#1f2937"
                    Padding="44,36"
                    WidthRequest="400">
                <VerticalStackLayout Spacing="16"
                                     HorizontalOptions="Fill">
                    <Label Text="Please scan your badge"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"/>
                    <BoxView HeightRequest="1"
                             BackgroundColor="#374151"
                             Margin="0,4"/>
                    <Grid ColumnDefinitions="*, Auto"
                          ColumnSpacing="8">
                        <Picker x:Name="OverlayComPortPicker"
                                Grid.Column="0"
                                Title="Select COM port"
                                SelectedIndexChanged="OnOverlayComPortSelected"
                                FontSize="12"
                                TextColor="#d1d5db"/>
                        <Button Grid.Column="1"
                                Text="Refresh"
                                Clicked="OnOverlayRefreshPorts"
                                BackgroundColor="#374151"
                                TextColor="White"
                                CornerRadius="6"
                                WidthRequest="72"
                                FontSize="12"
                                Padding="0,6"/>
                    </Grid>
                    <Label x:Name="OverlayScannerStatusLabel"
                           Text="No scanner connected"
                           FontSize="11"
                           TextColor="#6b7280"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
