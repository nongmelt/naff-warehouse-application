<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="app.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:app"
    xmlns:views="clr-namespace:app.Views"
    FlyoutBehavior="Disabled"
    Title="app">

    <ShellContent Route="home"      ContentTemplate="{DataTemplate views:HomePage}"/>
    <ShellContent Route="main"      ContentTemplate="{DataTemplate local:MainPage}"/>
    <ShellContent Route="orders"    ContentTemplate="{DataTemplate views:OrderSearchPage}"/>
    <ShellContent Route="packstation" ContentTemplate="{DataTemplate views:PackStationPage}"/>
    <ShellContent Route="workflows" ContentTemplate="{DataTemplate views:WorkflowViewPage}"/>

</Shell>
