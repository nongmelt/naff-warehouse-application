<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app.Views.EnrollmentPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#f3f4f6">

    <!-- First-launch enrollment. Shown as the root page when no MinIO credentials
         exist yet. The operator presses Connect — no codes to type. -->

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Primary purple fill, matches SettingsPage PrimaryActionButton -->
            <Style x:Key="ConnectButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="HeightRequest" Value="46"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#3f1fb0"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.45"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="24">
        <!-- Centered card -->
        <Border WidthRequest="448"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="White"
                Stroke="#e5e7eb"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.18" Radius="40" Offset="0,24"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">

                <!-- Body -->
                <VerticalStackLayout Padding="26,26,26,22" Spacing="0">

                    <!-- Eyebrow -->
                    <HorizontalStackLayout Spacing="8">
                        <Border WidthRequest="20" HeightRequest="20"
                                BackgroundColor="{StaticResource Primary}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 5">
                            <Label Text="W" TextColor="White" FontSize="11" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="FIRST-TIME SETUP"
                               TextColor="{StaticResource Primary}"
                               FontSize="11" FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Label Text="Connect this station"
                           FontSize="22" FontAttributes="Bold" TextColor="#111827"
                           Margin="0,12,0,5"/>
                    <Label Text="This computer needs to introduce itself to the warehouse once. Press Connect — there are no codes to type."
                           FontSize="13" TextColor="#6b7280" LineHeight="1.4"/>

                    <!-- ── Handshake strip: [this station] → [server] ── -->
                    <Grid ColumnDefinitions="*,56,*" Margin="0,22,0,2" ColumnSpacing="0">

                        <!-- This station (nameplate) -->
                        <Grid Grid.Column="0" ColumnDefinitions="5,*">
                            <BoxView Grid.Column="0" Color="{StaticResource Primary}"
                                     CornerRadius="6,0,0,6"/>
                            <Border Grid.Column="1"
                                    BackgroundColor="#f0ecfd"
                                    Stroke="#ddd3f7" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 0,11,0,11"
                                    Padding="12,10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="THIS STATION"
                                           FontSize="9" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"/>
                                    <Label x:Name="StationNameLabel"
                                           Text="this station"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="#111827"
                                           FontFamily="Consolas"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Connector arrow -->
                        <Grid Grid.Column="1" VerticalOptions="Center">
                            <BoxView HeightRequest="2" Color="#9ca3af"
                                     VerticalOptions="Center" Margin="4,0"/>
                            <Border x:Name="ConnPin"
                                    WidthRequest="24" HeightRequest="24"
                                    BackgroundColor="White"
                                    Stroke="#9ca3af" StrokeThickness="2"
                                    StrokeShape="RoundRectangle 12"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                <Grid>
                                    <Label x:Name="ConnPinGlyph" Text="→"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="#6b7280"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <ActivityIndicator x:Name="ConnSpinner"
                                                       IsVisible="False" IsRunning="False"
                                                       Color="{StaticResource Primary}"
                                                       WidthRequest="14" HeightRequest="14"
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Server -->
                        <Border x:Name="ServerNode" Grid.Column="2"
                                BackgroundColor="White"
                                Stroke="#e5e7eb" StrokeThickness="1"
                                StrokeShape="RoundRectangle 11"
                                Padding="12,10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="WAREHOUSE SERVER"
                                       FontSize="9" FontAttributes="Bold"
                                       TextColor="#6b7280"/>
                                <Label x:Name="ServerHostLabel"
                                       Text="—"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="#111827"
                                       FontFamily="Consolas"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Status line -->
                    <Border x:Name="StatusBorder"
                            BackgroundColor="#f9fafb"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,11" Margin="0,16,0,0">
                        <HorizontalStackLayout Spacing="9">
                            <Ellipse x:Name="StatusDot" WidthRequest="8" HeightRequest="8"
                                     Fill="#9ca3af" VerticalOptions="Start" Margin="0,5,0,0"/>
                            <Label x:Name="StatusLabel"
                                   Text="Ready to connect. This station will register itself and pick up its storage keys automatically."
                                   FontSize="12.5" TextColor="#6b7280" LineHeight="1.4"
                                   HorizontalOptions="StartAndExpand"/>
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- Footer buttons -->
                <VerticalStackLayout Padding="26,0,26,22" Spacing="9">
                    <Button x:Name="ActionButton"
                            Text="Connect to server"
                            Style="{StaticResource ConnectButton}"
                            Clicked="OnConnectClicked"/>
                </VerticalStackLayout>

                <!-- Machine footer -->
                <BoxView HeightRequest="1" Color="#e5e7eb"/>
                <Grid BackgroundColor="#fafafa" Padding="26,12">
                    <Label Text="⚙ Detected automatically · nothing here is typed by hand"
                           FontSize="11.5" TextColor="#9ca3af"/>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
