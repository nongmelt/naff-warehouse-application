# ============================================================
# NAFF Warehouse Application — Environment Configuration
# ============================================================
# Copy this file to docker/.env and fill in your values.
# Generated: 21/04/2026
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
# Full connection URL (used by backend)
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/warehouse

# ── MinIO ─────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=warehouse-videos

MINIO_PRODUCT_IMAGES_BUCKET=product-images
MINIO_MAX_IMAGE_SIZE=10MB
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── Rust Backend ──────────────────────────────────────────
BACKEND_PORT=8080
# Browser origin for the dashboard. Stage 1: the server IP via Traefik (:80).
# Stage 2: http://app.warehouse.local. Replace the IP with your server's.
CORS_ORIGIN=http://192.168.1.195
BACKEND_VERSION=1.0.0


# ── Next.js Frontend ──────────────────────────────────────
# Baked into the image at BUILD time — changing requires `docker compose build
# frontend`, not just a restart.
# Stage 1: set to the server's LAN IP (replace 192.168.1.195); the dashboard
#   reaches backend/minio via their published ports.
# Stage 2: switch to http://api.warehouse.local / ws://api.warehouse.local/... /
#   http://minio.warehouse.local once *.warehouse.local resolves.
NEXT_PUBLIC_API_URL=http://192.168.1.195:8080
NEXT_PUBLIC_WS_URL=ws://192.168.1.195:8080/packing-lists/events
NEXT_PUBLIC_MINIO_URL=http://192.168.1.195:9000
NEXT_PUBLIC_MINIO_BUCKET=warehouse-videos


# ── n8n ───────────────────────────────────────────────────
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=host.docker.internal
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=changeme