<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app.Views.SettingsPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="NavOutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor"  Value="Transparent"/>
                <Setter Property="TextColor"        Value="White"/>
                <Setter Property="BorderColor"      Value="White"/>
                <Setter Property="BorderWidth"      Value="1"/>
                <Setter Property="FontSize"         Value="12"/>
                <Setter Property="Padding"          Value="14,6"/>
                <Setter Property="CornerRadius"     Value="6"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent"/>
                                    <Setter Property="TextColor"       Value="White"/>
                                    <Setter Property="BorderColor"     Value="White"/>
                                    <Setter Property="BorderWidth"     Value="1"/>
                                    <Setter Property="Opacity"         Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="White"/>
                                    <Setter Property="TextColor"       Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderColor"     Value="White"/>
                                    <Setter Property="BorderWidth"     Value="1"/>
                                    <Setter Property="Opacity"         Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#e0e7ff"/>
                                    <Setter Property="TextColor"       Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderColor"     Value="White"/>
                                    <Setter Property="Opacity"         Value="0.85"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.35"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Primary-fill button that turns white on hover, stable size -->
            <Style x:Key="PrimaryActionButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                <Setter Property="TextColor"       Value="White"/>
                <Setter Property="BorderColor"     Value="{StaticResource Primary}"/>
                <Setter Property="BorderWidth"     Value="1"/>
                <Setter Property="CornerRadius"    Value="8"/>
                <Setter Property="FontSize"        Value="14"/>
                <Setter Property="Padding"         Value="24,12"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                    <Setter Property="TextColor"       Value="White"/>
                                    <Setter Property="BorderColor"     Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderWidth"     Value="1"/>
                                    <Setter Property="Opacity"         Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="White"/>
                                    <Setter Property="TextColor"       Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderColor"     Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderWidth"     Value="1"/>
                                    <Setter Property="Opacity"         Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#e0e7ff"/>
                                    <Setter Property="TextColor"       Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderColor"     Value="{StaticResource Primary}"/>
                                    <Setter Property="Opacity"         Value="0.85"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.35"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,10">
            <Label Text="Settings"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>
            <Button Text="✕ Close"
                    Clicked="OnCancel"
                    Style="{StaticResource NavOutlineButton}"
                    HorizontalOptions="End"/>
        </Grid>

        <!-- Sidebar + Content — 3 cols: sidebar | 1px divider | content -->
        <Grid Grid.Row="1" ColumnDefinitions="200, 1, *" ColumnSpacing="0">

            <!-- Sidebar -->
            <VerticalStackLayout Grid.Column="0" BackgroundColor="White" Spacing="0">

                <!-- GENERAL -->
                <Label Text="GENERAL"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#9ca3af"
                       Margin="16,20,16,4"/>

                <Border x:Name="NavGeneralBorder"
                        BackgroundColor="#eff6ff"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 6"
                        Padding="12,9"
                        Margin="8,2">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavGeneral"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="NavGeneralLabel"
                           Text="General"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#2563eb"/>
                </Border>

                <!-- BACKEND -->
                <Label Text="BACKEND"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#9ca3af"
                       Margin="16,20,16,4"/>

                <Border x:Name="NavApiBorder"
                        BackgroundColor="Transparent"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 6"
                        Padding="12,9"
                        Margin="8,2">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavApi"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="NavApiLabel"
                           Text="Backend API"
                           FontSize="13"
                           TextColor="#374151"/>
                </Border>

            </VerticalStackLayout>

            <!-- Divider -->
            <BoxView Grid.Column="1" BackgroundColor="#e5e7eb"/>

            <!-- Content area -->
            <Grid Grid.Column="2" BackgroundColor="#f3f4f6">

                <!-- ── General Panel (scrollable) ── -->
                <ScrollView x:Name="PanelGeneral" IsVisible="False" BackgroundColor="#f3f4f6">
                    <VerticalStackLayout Padding="28,24"
                                         Spacing="20"
                                         MaximumWidthRequest="620"
                                         HorizontalOptions="Center">

                        <Label Text="General"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#111827"
                               Margin="0,0,0,4"/>

                        <!-- Video Folder -->
                        <Border Stroke="#d1d5db" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                BackgroundColor="White" Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Video Destination Folder"
                                       FontAttributes="Bold" FontSize="14" TextColor="#111827"/>
                                <Label Text="Recordings are saved into a date-stamped sub-folder inside this directory."
                                       FontSize="12" TextColor="#6b7280"/>
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <Border Grid.Column="0" Stroke="#d1d5db" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6" Padding="10,0">
                                        <Entry x:Name="VideoFolderEntry"
                                               Placeholder="e.g. C:\Users\Operator\Documents\NAFFWarehouse Videos"
                                               FontSize="13" VerticalOptions="Center"/>
                                    </Border>
                                    <Button Grid.Column="1" Text="Browse…" Clicked="OnBrowseFolder"
                                            WidthRequest="90" FontSize="13" Padding="0,8" CornerRadius="6"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Webhook URL -->
                        <Border Stroke="#d1d5db" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                BackgroundColor="White" Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="n8n Webhook URL"
                                       FontAttributes="Bold" FontSize="14" TextColor="#111827"/>
                                <Label Text="The full webhook URL that receives barcode and video file notifications."
                                       FontSize="12" TextColor="#6b7280"/>
                                <Border Stroke="#d1d5db" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10,0">
                                    <Entry x:Name="WebhookUrlEntry"
                                           Placeholder="http://localhost:5678/webhook-test/..."
                                           FontSize="13" Keyboard="Url"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Save row -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label x:Name="GeneralSavedLabel"
                                   Grid.Column="0"
                                   Text="✓ Saved"
                                   TextColor="#16a34a"
                                   FontSize="13"
                                   IsVisible="False"
                                   VerticalOptions="Center"/>
                            <Button Grid.Column="1"
                                    Text="Save"
                                    Clicked="OnSaveGeneral"
                                    Style="{StaticResource PrimaryActionButton}"/>
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- ── Backend API Panel ── -->
                <Grid x:Name="PanelApi"
                      IsVisible="False"
                      RowDefinitions="Auto, *"
                      Padding="28,24"
                      RowSpacing="0"
                      BackgroundColor="#f3f4f6">

                    <!-- Title -->
                    <Label Grid.Row="0"
                           Text="Backend API"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#111827"
                           Margin="0,0,0,16"/>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="16"
                                             MaximumWidthRequest="620"
                                             HorizontalOptions="Center">

                            <!-- Notification card -->
                            <Border x:Name="NotificationCard"
                                    IsVisible="False"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="16,14">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                    <Label x:Name="NotificationMessageLabel"
                                           Grid.Column="0"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                    <Button x:Name="RetryButton"
                                            Grid.Column="1"
                                            Text="Retry"
                                            Clicked="OnRetryConnection"
                                            FontSize="11"
                                            CornerRadius="6"
                                            Padding="14,4"
                                            BorderWidth="1"
                                            VerticalOptions="Center">
                                        <Button.GestureRecognizers>
                                            <PointerGestureRecognizer
                                                PointerEntered="OnRetryButtonEntered"
                                                PointerExited="OnRetryButtonExited"/>
                                        </Button.GestureRecognizers>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- API URL card -->
                            <Border Stroke="#d1d5db"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="White"
                                    Padding="24">
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="API URL"
                                           FontAttributes="Bold" FontSize="15" TextColor="#111827"/>
                                    <Label Text="Base URL of the backend service. The desktop app sends all database requests here instead of connecting to PostgreSQL directly."
                                           FontSize="12" TextColor="#6b7280"/>
                                    <Border Stroke="#d1d5db" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10,0">
                                        <Entry x:Name="ApiUrlEntry"
                                               Placeholder="http://localhost:8080"
                                               Keyboard="Url"
                                               FontSize="13"
                                               VerticalOptions="Center"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Save button -->
                            <Button Text="Save &amp; Test"
                                    Clicked="OnSaveApi"
                                    Style="{StaticResource PrimaryActionButton}"
                                    HorizontalOptions="End"/>

                        </VerticalStackLayout>
                    </ScrollView>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</ContentPage>
