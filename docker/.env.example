# ============================================================
# NAFF Warehouse Application — Environment Configuration
# ============================================================
# Copy this file to docker/.env and fill in your values.
# Generated: 21/04/2026
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
# Full connection URL (used by backend)
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/warehouse

# ── MinIO ─────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=warehouse-videos

MINIO_PRODUCT_IMAGES_BUCKET=product-images
MINIO_MAX_IMAGE_SIZE=10MB
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Only for compose.traefik.prod.yml (MinIO on a SEPARATE host). The IP Traefik
# uses to reach external MinIO for /s3. Leave unset when MinIO runs via
# compose.minio.yml (same host) — Docker DNS resolves the `minio` container.
MINIO_UPSTREAM_IP=192.168.1.50

# ── Rust Backend ──────────────────────────────────────────
BACKEND_PORT=8080
# CORS is NOT exercised when the dashboard goes through Traefik: the browser
# calls /api on the SAME origin it loaded the page from, so no cross-origin
# request is made. This value only matters for a client that hits the backend on
# :8080 directly from a different web origin. A valid value is still required
# (the backend parses it at startup). Leave as-is unless you need direct access.
CORS_ORIGIN=http://localhost
BACKEND_VERSION=1.0.0


# ── Next.js Frontend ──────────────────────────────────────
# Baked into the image at BUILD time — changing requires `docker compose build
# frontend`, not just a restart.
#
# SAME-ORIGIN (relative) URLs: no IP/host here. The browser sends these to the
# same host:port it loaded the dashboard from, and Traefik path-routes them
# (/api -> backend, /s3 -> minio). This is what lets every subnet work from one
# image — DO NOT put a server IP here or you re-create the single-subnet problem.
# The WS path is relative too; the browser resolves ws://<that-host>/api/... .
# (Local dev without Traefik: leave .env unset — the code falls back to
#  http://localhost:8080 / ws://localhost:8080/... .)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/api/packing-lists/events
NEXT_PUBLIC_MINIO_URL=/s3
NEXT_PUBLIC_MINIO_BUCKET=warehouse-videos


# ── n8n ───────────────────────────────────────────────────
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=host.docker.internal
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=changeme