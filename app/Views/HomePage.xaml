<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app.Views.HomePage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="NavOutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor"  Value="Transparent"/>
                <Setter Property="TextColor"        Value="White"/>
                <Setter Property="BorderColor"      Value="White"/>
                <Setter Property="BorderWidth"      Value="1"/>
                <Setter Property="FontSize"         Value="12"/>
                <Setter Property="Padding"          Value="14,6"/>
                <Setter Property="CornerRadius"     Value="6"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent"/>
                                    <Setter Property="TextColor"       Value="White"/>
                                    <Setter Property="BorderColor"     Value="White"/>
                                    <Setter Property="BorderWidth"     Value="1"/>
                                    <Setter Property="Opacity"         Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="White"/>
                                    <Setter Property="TextColor"       Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderColor"     Value="White"/>
                                    <Setter Property="BorderWidth"     Value="1"/>
                                    <Setter Property="Opacity"         Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#e0e7ff"/>
                                    <Setter Property="TextColor"       Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderColor"     Value="White"/>
                                    <Setter Property="Opacity"         Value="0.85"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.35"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <!-- Header bar -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,10">
            <Label Text="Warehouse"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>
            <Button Text="⚙ Settings"
                    Clicked="OnOpenSettings"
                    Style="{StaticResource NavOutlineButton}"
                    HorizontalOptions="End"/>
        </Grid>

        <!-- Body: title pinned to top, cards centred in remaining space -->
        <Grid Grid.Row="1" BackgroundColor="#f3f4f6" RowDefinitions="Auto, *">

            <!-- "Select a site" — top of body -->
            <Label Grid.Row="0"
                   Text="Select a site"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#111827"
                   HorizontalOptions="Center"
                   Margin="0,36,0,0"/>

            <!-- Cards — centred in the remaining space -->
            <HorizontalStackLayout Grid.Row="1"
                                   Spacing="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">

                <!-- Packing Stations card -->
                <Border x:Name="StationsCard"
                        Stroke="#e5e7eb"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="36,32"
                        MinimumWidthRequest="220">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoToStations"/>
                        <PointerGestureRecognizer
                            PointerEntered="OnStationsCardEntered"
                            PointerExited="OnStationsCardExited"
                            PointerPressed="OnStationsCardPressed"
                            PointerReleased="OnStationsCardReleased"/>
                    </Border.GestureRecognizers>
                    <!-- InputTransparent lets pointer events pass through to the Border's recognizers -->
                    <VerticalStackLayout InputTransparent="True"
                                         Spacing="14"
                                         HorizontalOptions="Center">
                        <Label Text="📦" FontSize="44" HorizontalOptions="Center"/>
                        <Label Text="Packing Stations"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#111827"
                               HorizontalOptions="Center"/>
                        <Label Text="Webcam recording triggered&#10;by barcode scan"
                               FontSize="12"
                               TextColor="#6b7280"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="StationsArrow"
                               Text="Open →"
                               FontSize="12"
                               TextColor="#9ca3af"
                               HorizontalOptions="Center"
                               Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Order Search card -->
                <Border x:Name="OrdersCard"
                        Stroke="#e5e7eb"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="36,32"
                        MinimumWidthRequest="220">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoToOrders"/>
                        <PointerGestureRecognizer
                            PointerEntered="OnOrdersCardEntered"
                            PointerExited="OnOrdersCardExited"
                            PointerPressed="OnOrdersCardPressed"
                            PointerReleased="OnOrdersCardReleased"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout InputTransparent="True"
                                         Spacing="14"
                                         HorizontalOptions="Center">
                        <Label Text="🔍" FontSize="44" HorizontalOptions="Center"/>
                        <Label Text="Order Search"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#111827"
                               HorizontalOptions="Center"/>
                        <Label Text="Look up orders and tracking&#10;numbers from the database"
                               FontSize="12"
                               TextColor="#6b7280"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="OrdersArrow"
                               Text="Open →"
                               FontSize="12"
                               TextColor="#9ca3af"
                               HorizontalOptions="Center"
                               Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

            </HorizontalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
