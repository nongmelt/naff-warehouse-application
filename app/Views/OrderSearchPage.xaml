<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:app.Models"
             xmlns:views="clr-namespace:app.Views"
             x:Class="app.Views.OrderSearchPage"
             x:DataType="views:OrderSearchPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="NavOutlineButton"
                   TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="Transparent"/>
                <Setter Property="TextColor"
                        Value="White"/>
                <Setter Property="BorderColor"
                        Value="White"/>
                <Setter Property="BorderWidth"
                        Value="1"/>
                <Setter Property="FontSize"
                        Value="12"/>
                <Setter Property="Padding"
                        Value="14,6"/>
                <Setter Property="CornerRadius"
                        Value="6"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="Transparent"/>
                                    <Setter Property="TextColor"
                                            Value="White"/>
                                    <Setter Property="BorderColor"
                                            Value="White"/>
                                    <Setter Property="BorderWidth"
                                            Value="1"/>
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="White"/>
                                    <Setter Property="TextColor"
                                            Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderColor"
                                            Value="White"/>
                                    <Setter Property="BorderWidth"
                                            Value="1"/>
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="#e0e7ff"/>
                                    <Setter Property="TextColor"
                                            Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderColor"
                                            Value="White"/>
                                    <Setter Property="Opacity"
                                            Value="0.85"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="0.35"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Filled button with pointer-over highlight -->
            <Style x:Key="HoverButton"
                   TargetType="Button">
                <Setter Property="CornerRadius"
                        Value="6"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="0.78"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="0.6"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="0.35"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Header bar -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,10">
            <Button Text="⌂ Home"
                    Clicked="OnGoHome"
                    Style="{StaticResource NavOutlineButton}"
                    HorizontalOptions="Start"/>
            <Label Text="Order Search"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
            <HorizontalStackLayout HorizontalOptions="End"
                                   Spacing="12"
                                   VerticalOptions="Center">
                <Label Text="{Binding StationNameDisplay}"
                       TextColor="White"
                       FontSize="12"
                       Opacity="0.8"
                       VerticalOptions="Center"/>
                <Button Text="Open Logs"
                        Clicked="OnOpenLogs"
                        Style="{StaticResource NavOutlineButton}"/>
                <Button Text="⚙ Settings"
                        Clicked="OnOpenSettings"
                        Style="{StaticResource NavOutlineButton}"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Fixed top bar: Scanner (1/3) + Search (2/3) -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*, 2*"
              ColumnSpacing="12"
              BackgroundColor="#f3f4f6"
              Padding="24,16,24,12">

            <!-- Scanner card -->
            <Border Grid.Column="0"
                    Stroke="#d1d5db"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="White"
                    Padding="12,10">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Barcode Scanner"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#111827"/>
                    <Grid ColumnDefinitions="*, Auto"
                          ColumnSpacing="8">
                        <Picker x:Name="ComPortPicker"
                                Grid.Column="0"
                                Title="Select COM port"
                                SelectedIndexChanged="OnComPortSelected"
                                FontSize="12"/>
                        <Button Grid.Column="1"
                                Text="Refresh"
                                Clicked="OnRefreshPorts"
                                Style="{StaticResource HoverButton}"
                                WidthRequest="72"
                                FontSize="12"
                                Padding="0,6"/>
                    </Grid>
                    <Label x:Name="ScannerStatusLabel"
                           Text="No scanner connected"
                           FontSize="11"
                           TextColor="#6b7280"
                           MinimumHeightRequest="16"/>
                </VerticalStackLayout>
            </Border>

            <!-- Search card -->
            <Border Grid.Column="1"
                    Stroke="#d1d5db"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="White"
                    Padding="12,10">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Search"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#111827"/>
                    <Grid ColumnDefinitions="*, Auto"
                          ColumnSpacing="8">
                        <Entry x:Name="SearchEntry"
                               Grid.Column="0"
                               Placeholder="Tracking or order number…"
                               FontSize="13"
                               ReturnType="Search"
                               Completed="OnSearchCommitted"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="Search"
                                Clicked="OnSearchClicked"
                                Style="{StaticResource HoverButton}"
                                WidthRequest="80"
                                FontSize="13"
                                Padding="0,6"/>
                    </Grid>
                    <Label x:Name="SearchStatusLabel"
                           Text=" "
                           FontSize="11"
                           TextColor="#6b7280"
                           MinimumHeightRequest="16"/>
                </VerticalStackLayout>
            </Border>

        </Grid>

        <!-- Scrollable results -->
        <ScrollView Grid.Row="2"
                    BackgroundColor="#f3f4f6">
            <VerticalStackLayout Padding="24,0,24,24"
                                 Spacing="0">

                <CollectionView x:Name="ResultsView"
                                ItemsSource="{Binding Results}"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <Label x:Name="EmptyLabel"
                               Text=""
                               FontSize="13"
                               TextColor="#9ca3af"
                               HorizontalOptions="Center"
                               Margin="0,24"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PackingList">
                            <VerticalStackLayout Spacing="6"
                                                 Margin="0,16,0,0">

                                <!-- Summary card -->
                                <Border Stroke="#d1d5db"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="White"
                                        Padding="14,8">
                                    <VerticalStackLayout Spacing="3">
                                        <!-- Tracking + platform icon + status -->
                                        <Grid ColumnDefinitions="Auto, *, Auto"
                                              ColumnSpacing="10">
                                            <!-- Platform icon (only when known) -->
                                            <Image Grid.Column="0"
                                                   Source="{Binding PlatformIcon}"
                                                   IsVisible="{Binding HasPlatformIcon}"
                                                   WidthRequest="48"
                                                   HeightRequest="48"
                                                   Aspect="AspectFit"
                                                   VerticalOptions="Center"/>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="1"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding TrackingNumber}"
                                                       FontAttributes="Bold"
                                                       FontSize="18"
                                                       TextColor="#111827"/>
                                                <!-- Submitted + Checked at on same line -->
                                                <HorizontalStackLayout Spacing="14">
                                                    <Label FontSize="11"
                                                           TextColor="#9ca3af">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Submitted: "/>
                                                                <Span Text="{Binding CreatedAtDisplay}"
                                                                      TextColor="#6b7280"/>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label FontSize="11"
                                                           TextColor="#9ca3af"
                                                           IsVisible="{Binding HasBeenChecked}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Checked at: "/>
                                                                <Span Text="{Binding CheckedAtDisplay}"
                                                                      TextColor="#6b7280"/>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </HorizontalStackLayout>
                                                <!-- Packed by + Checked by beside tracking -->
                                                <HorizontalStackLayout Spacing="14">
                                                    <Label FontSize="11"
                                                           TextColor="#9ca3af">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Packed by: "/>
                                                                <Span Text="{Binding PackedByDisplay}"
                                                                      TextColor="#6b7280"/>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label FontSize="11"
                                                           TextColor="#9ca3af">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Checked by: "/>
                                                                <Span Text="{Binding CheckedByDisplay}"
                                                                      TextColor="#6b7280"/>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <!-- Status badge(s) + Reset button -->
                                            <VerticalStackLayout Grid.Column="2"
                                                                 Spacing="3"
                                                                 HorizontalOptions="End"
                                                                 VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="4"
                                                                       HorizontalOptions="End">
                                                    <Border BackgroundColor="{Binding StatusBgColor}"
                                                            Stroke="Transparent"
                                                            StrokeShape="RoundRectangle 4"
                                                            Padding="8,3">
                                                        <Label Text="{Binding StatusDisplay}"
                                                               TextColor="{Binding StatusFgColor}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"/>
                                                    </Border>
                                                    <!-- Green "✓ QC Passed" — only when Packed Complete -->
                                                    <Border IsVisible="{Binding IsPackedComplete}"
                                                            BackgroundColor="#dcfce7"
                                                            Stroke="#86efac"
                                                            StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 4"
                                                            Padding="8,3">
                                                        <Label Text="✓ QC Passed"
                                                               TextColor="#166534"
                                                               FontSize="11"
                                                               FontAttributes="Bold"/>
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <!-- Reset — always reserves height so all cards stay the same size -->
                                                <Button Text="Reset"
                                                        Clicked="OnResetClicked"
                                                        Opacity="{Binding ResetOpacity}"
                                                        InputTransparent="{Binding IsNotQcHold}"
                                                        HorizontalOptions="End"
                                                        FontSize="11"
                                                        Padding="8,3"
                                                        BackgroundColor="#fef9c3"
                                                        TextColor="#713f12"
                                                        CornerRadius="6"
                                                        BorderColor="#fde68a"
                                                        BorderWidth="1"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                        <!-- Meta row -->
                                        <HorizontalStackLayout Spacing="16">
                                            <Label FontSize="11"
                                                   TextColor="#6b7280">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Order: "
                                                              TextColor="#9ca3af"/>
                                                        <Span Text="{Binding OrderNumber}"
                                                              TextColor="#374151"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="11"
                                                   TextColor="#6b7280">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Items: "
                                                              TextColor="#9ca3af"/>
                                                        <Span Text="{Binding TotalItemsDisplay}"
                                                              TextColor="#374151"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <HorizontalStackLayout Spacing="3"
                                                                   VerticalOptions="Center"
                                                                   IsVisible="{Binding HasBeenUpdated}">
                                                <Label Text="↻"
                                                       TextColor="#2563eb"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                                <Label FontSize="11"
                                                       TextColor="#6b7280"
                                                       VerticalOptions="Center">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Updated: "
                                                                  TextColor="#9ca3af"/>
                                                            <Span Text="{Binding UpdatedAtDisplay}"
                                                                  TextColor="#374151"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Individual product cards -->
                                <VerticalStackLayout IsVisible="{Binding HasProducts}"
                                                     BindableLayout.ItemsSource="{Binding ParsedProducts}"
                                                     Spacing="4">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProductItem">
                                            <Border Stroke="#e5e7eb"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 6"
                                                    BackgroundColor="{Binding CardBgColor}"
                                                    Padding="14,10">
                                                <Border.GestureRecognizers>
                                                    <PointerGestureRecognizer
                                                        PointerEntered="OnProductCardEntered"
                                                        PointerExited="OnProductCardExited"/>
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*, Auto, Auto"
                                                      ColumnSpacing="12">
                                                    <!-- Name + Variation + SKU -->
                                                    <VerticalStackLayout Grid.Column="0"
                                                                         Spacing="3"
                                                                         InputTransparent="True">
                                                        <Label Text="{Binding Name}"
                                                               FontAttributes="Bold"
                                                               FontSize="13"
                                                               TextColor="#111827"
                                                               LineBreakMode="WordWrap"/>
                                                        <Label FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="#2563eb"
                                                               IsVisible="{Binding HasVariation}"
                                                               LineBreakMode="TailTruncation">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="Category: " TextColor="#9ca3af" FontAttributes="None"/>
                                                                    <Span Text="{Binding Variation}"/>
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <Label FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#374151"
                                                               LineBreakMode="TailTruncation">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="SKU: " TextColor="#9ca3af" FontAttributes="None"/>
                                                                    <Span Text="{Binding SellerSku}"/>
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                    <!-- Divider -->
                                                    <BoxView Grid.Column="1"
                                                             WidthRequest="1"
                                                             BackgroundColor="#e5e7eb"
                                                             VerticalOptions="Fill"
                                                             InputTransparent="True"/>
                                                    <!-- Quantity + inline pick entry (tap to deduct) -->
                                                    <VerticalStackLayout Grid.Column="2"
                                                                         HorizontalOptions="Center"
                                                                         VerticalOptions="Center"
                                                                         Spacing="2">
                                                        <VerticalStackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnQuantityTapped"/>
                                                        </VerticalStackLayout.GestureRecognizers>
                                                        <HorizontalStackLayout HorizontalOptions="Center"
                                                                               Spacing="10"
                                                                               VerticalOptions="Center">
                                                            <Label Text="{Binding Quantity}"
                                                                   FontSize="28"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#111827"
                                                                   VerticalOptions="Center"/>
                                                            <Entry IsVisible="{Binding IsBeingPicked}"
                                                                   Text="{Binding PickQtyText}"
                                                                   Keyboard="Numeric"
                                                                   WidthRequest="64"
                                                                   FontSize="20"
                                                                   FontAttributes="Bold"
                                                                   HorizontalTextAlignment="Center"
                                                                   ReturnType="Done"
                                                                   Completed="OnPickQtyEntryCompleted"
                                                                   TextChanged="OnPickQtyTextChanged"
                                                                   VerticalOptions="Center"/>
                                                        </HorizontalStackLayout>
                                                        <Label Text="qty"
                                                               FontSize="10"
                                                               TextColor="#9ca3af"
                                                               HorizontalTextAlignment="Center"
                                                               InputTransparent="True"/>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
