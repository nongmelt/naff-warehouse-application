<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="app.Controls.StationView">

    <Border x:Name="CardBorder"
            Stroke="#d1d5db"
            StrokeThickness="1"
            Margin="4"
            StrokeShape="RoundRectangle 8">

        <Grid RowDefinitions="*, Auto, Auto">

            <!-- ── Row 0: Camera area (tap here to select this station) ── -->
            <Grid Grid.Row="0" BackgroundColor="#111827">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCameraAreaTapped"/>
                </Grid.GestureRecognizers>

                <!-- Placeholder when no camera is selected -->
                <VerticalStackLayout x:Name="NoCameraPlaceholder"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="6">
                    <Label Text="No Camera"
                           TextColor="#4b5563"
                           FontSize="16"
                           HorizontalOptions="Center"/>
                    <Label Text="Select a camera below"
                           TextColor="#374151"
                           FontSize="12"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Live camera feed -->
                <toolkit:CameraView x:Name="CameraFeed"
                                    IsVisible="False"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"/>

                <!-- Red border overlay while recording -->
                <Border x:Name="RecordingBorder"
                        IsVisible="False"
                        Stroke="#ef4444"
                        StrokeThickness="3"
                        StrokeShape="Rectangle"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        InputTransparent="True"/>

                <!-- Barcode badge — top-right overlay, visible while recording -->
                <Border x:Name="BarcodeBadge"
                        BackgroundColor="#CC000000"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="0"
                        Padding="12,6"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,8,8,0"
                        IsVisible="False">
                    <Label x:Name="BarcodeLabel"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="End"/>
                </Border>

                <!-- REC badge — top-left overlay -->
                <Border x:Name="RecBadge"
                        BackgroundColor="#ef4444"
                        StrokeShape="RoundRectangle 4"
                        StrokeThickness="0"
                        Padding="8,3"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="8,8,0,0"
                        IsVisible="False">
                    <Label Text="● REC"
                           TextColor="White"
                           FontSize="11"
                           FontAttributes="Bold"/>
                </Border>

                <!-- Video count badge — bottom-right overlay -->
                <Border x:Name="VideoCountBadge"
                        BackgroundColor="#CC000000"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="0"
                        Padding="12,6"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Margin="0,0,8,8"
                        IsVisible="False">
                    <Label x:Name="VideoCountLabel"
                           TextColor="White"
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/></Border>

            </Grid>

            <!-- ── Row 1: Collapsible controls panel (hidden by default) ── -->
            <VerticalStackLayout x:Name="ControlsPanel"
                                 Grid.Row="1"
                                 IsVisible="False"
                                 BackgroundColor="White"
                                 Padding="10,8"
                                 Spacing="6">

                <!-- Camera picker + lock toggle -->
                <Grid ColumnDefinitions="*, Auto">
                    <Picker x:Name="CameraPicker"
                            Grid.Column="0"
                            Title="Select Camera"
                            FontSize="12"
                            SelectedIndexChanged="OnCameraSelected"/>
                    <Button x:Name="CameraLockButton"
                            Grid.Column="1"
                            Text="🔓"
                            FontSize="14"
                            HeightRequest="34"
                            WidthRequest="34"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="#9ca3af"
                            CornerRadius="4"
                            Clicked="OnCameraLockClicked"/>
                </Grid>

                <!-- Scanner (COM port) picker + lock toggle -->
                <Grid ColumnDefinitions="*, Auto">
                    <Picker x:Name="ComPortPicker"
                            Grid.Column="0"
                            Title="Select COM Port (Barcode Scanner)"
                            FontSize="12"
                            SelectedIndexChanged="OnComPortSelected"/>
                    <Button x:Name="ScannerLockButton"
                            Grid.Column="1"
                            Text="🔓"
                            FontSize="14"
                            HeightRequest="34"
                            WidthRequest="34"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="#9ca3af"
                            CornerRadius="4"
                            Clicked="OnScannerLockClicked"/>
                </Grid>

            </VerticalStackLayout>

            <!-- ── Row 2: Always-visible footer strip ── -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto, Auto, *, Auto"
                  BackgroundColor="White"
                  Padding="6,4">

                <!-- Pencil edit button -->
                <Button x:Name="EditNameButton"
                        Grid.Column="0"
                        Text="✏"
                        FontSize="13"
                        HeightRequest="34"
                        WidthRequest="30"
                        Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="#9ca3af"
                        CornerRadius="4"
                        Clicked="OnEditNameClicked"/>

                <!-- Station name (display) -->
                <Label x:Name="StationNameLabel"
                       Grid.Column="1"
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="#111827"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       MaximumWidthRequest="160"/>

                <!-- Station name (in-place edit — shown instead of label when editing) -->
                <Entry x:Name="StationNameEntry"
                       Grid.Column="1"
                       IsVisible="False"
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="#111827"
                       BackgroundColor="Transparent"
                       Placeholder="Station name"
                       ReturnType="Done"
                       Completed="OnNameEntryCompleted"
                       Unfocused="OnNameEntryUnfocused"/>

                <!-- Status — always visible beside station name -->
                <Label x:Name="StatusLabel"
                       Grid.Column="2"
                       Text="Ready to Scan"
                       FontSize="11"
                       TextColor="#6b7280"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       LineBreakMode="TailTruncation"
                       Margin="8,0,0,0"/>

                <!-- Collapse / expand toggle -->
                <Button x:Name="ToggleButton"
                        Grid.Column="3"
                        Text="▼"
                        FontSize="12"
                        HeightRequest="34"
                        WidthRequest="34"
                        Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="#6b7280"
                        CornerRadius="4"
                        Clicked="OnToggleControls"/>

            </Grid>

        </Grid>

    </Border>

</ContentView>
