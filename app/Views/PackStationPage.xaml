<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app.Views.PackStationPage"
             x:DataType="views:PackStationPage"
             xmlns:views="clr-namespace:app.Views"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="NavOutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor"       Value="White"/>
                <Setter Property="BorderColor"     Value="White"/>
                <Setter Property="BorderWidth"     Value="1"/>
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="Padding"         Value="14,6"/>
                <Setter Property="CornerRadius"    Value="6"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              BackgroundColor="{StaticResource Primary}"
              Padding="12,7">
            <Button Grid.Column="0"
                    Text="&#x2302; Home"
                    Clicked="OnGoHome"
                    Style="{StaticResource NavOutlineButton}"/>
            <Label Grid.Column="1"
                   Text="Shipping"
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                <!-- COM port dropdown badge (always reachable, like Order Search) -->
                <Border x:Name="ComPortBadge"
                        BackgroundColor="#1Affffff"
                        Stroke="#30ffffff"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 6"
                        Padding="12,6"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnComPortBadgeTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="COM"
                               TextColor="#cbd5e1"
                               FontSize="10"
                               VerticalOptions="Center"/>
                        <Label x:Name="ComPortBadgeLabel"
                               Text="None"
                               TextColor="White"
                               FontSize="12"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <Label Text="&#x25BE;"
                               TextColor="#cbd5e1"
                               FontSize="10"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <!-- Operator badge -->
                <Border x:Name="OperatorHeaderBadge"
                        IsVisible="False"
                        BackgroundColor="Transparent"
                        Stroke="Transparent"
                        Padding="0"
                        VerticalOptions="Center">
                    <Label x:Name="HeaderComputerOperatorLabel"
                           Text=""
                           TextColor="White"
                           FontSize="13"
                           VerticalOptions="Center"/>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- Scan history belt (visible once logged in) — mirrors Order Search belt -->
        <Border x:Name="HistoryBelt"
                Grid.Row="1"
                IsVisible="False"
                BackgroundColor="White"
                Stroke="#e5e7eb"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 0"
                Padding="0">
            <Grid ColumnDefinitions="Auto, *" Padding="6,4">

                <!-- Left: packed total + platform/carrier breakdowns (seal-only counts) -->
                <HorizontalStackLayout Grid.Column="0" Spacing="14" VerticalOptions="Center" Padding="6,0">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="PACKED" FontSize="9" FontAttributes="Bold" TextColor="#6b7280"/>
                        <Label x:Name="PackedTotalLabel" Text="0" FontSize="30" FontAttributes="Bold" TextColor="#16a34a"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                        <!-- Platform row -->
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Border BackgroundColor="#fff1ed" Stroke="#fbcab9" StrokeThickness="1" StrokeShape="RoundRectangle 7" Padding="8,4">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <BoxView WidthRequest="8" HeightRequest="8" Color="#EE4D2D" CornerRadius="4" VerticalOptions="Center"/>
                                    <Label x:Name="ShopeeCountLabel" Text="0" FontSize="13" FontAttributes="Bold" TextColor="#EE4D2D" VerticalOptions="Center"/>
                                    <Label Text="Shopee" FontSize="11" TextColor="#374151" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                            <Border BackgroundColor="#eef0fb" Stroke="#c3c8ee" StrokeThickness="1" StrokeShape="RoundRectangle 7" Padding="8,4">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <BoxView WidthRequest="8" HeightRequest="8" Color="#0F146D" CornerRadius="4" VerticalOptions="Center"/>
                                    <Label x:Name="LazadaCountLabel" Text="0" FontSize="13" FontAttributes="Bold" TextColor="#0F146D" VerticalOptions="Center"/>
                                    <Label Text="Lazada" FontSize="11" TextColor="#374151" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                            <Border BackgroundColor="#f3f4f6" Stroke="#d1d5db" StrokeThickness="1" StrokeShape="RoundRectangle 7" Padding="8,4">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <BoxView WidthRequest="8" HeightRequest="8" Color="#000000" CornerRadius="4" VerticalOptions="Center"/>
                                    <Label x:Name="TiktokCountLabel" Text="0" FontSize="13" FontAttributes="Bold" TextColor="#111827" VerticalOptions="Center"/>
                                    <Label Text="TikTok" FontSize="11" TextColor="#374151" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Carrier row (dynamic, persisted) -->
                        <HorizontalStackLayout x:Name="CarrierPillStrip" Spacing="6" VerticalOptions="Center"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Right: carousel of scanned parcels, coloured by status -->
                <ScrollView Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            VerticalOptions="Center"
                            Padding="8,0">
                    <HorizontalStackLayout x:Name="HistoryStrip" Spacing="4" VerticalOptions="Center"/>
                </ScrollView>

            </Grid>
        </Border>

        <!-- Body: idle prompt -->
        <VerticalStackLayout x:Name="IdlePrompt"
                             Grid.Row="2"
                             BackgroundColor="#f3f4f6"
                             HorizontalOptions="Fill"
                             VerticalOptions="Fill"
                             Spacing="10">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="10">
                <Label Text="&#x1F3F7;&#xFE0F;"
                       FontSize="64"
                       HorizontalOptions="Center"/>
                <Label Text="Scan a parcel barcode"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#111827"
                       HorizontalOptions="Center"/>
                <Label x:Name="IdleStationLabel"
                       Text=""
                       FontSize="14"
                       TextColor="#6b7280"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Welcome banner -->
        <Border x:Name="WelcomeBanner"
                Grid.Row="2"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="#1e3a5f"
                Stroke="#3b82f6"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="36,22"
                InputTransparent="True"
                ZIndex="9">
            <Label x:Name="WelcomeLabel"
                   Text=""
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>
        </Border>

        <!-- Login overlay (covers body only; header Home stays reachable) -->
        <Grid x:Name="LoginOverlay"
              Grid.Row="2"
              BackgroundColor="#CC111827"
              IsVisible="True"
              ZIndex="10">
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="#374151"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#1f2937"
                    Padding="44,36"
                    WidthRequest="400">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">
                    <Label Text="Please scan your badge"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"/>
                    <BoxView HeightRequest="1" BackgroundColor="#374151" Margin="0,4"/>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Picker x:Name="OverlayComPortPicker"
                                Grid.Column="0"
                                Title="Select COM port"
                                SelectedIndexChanged="OnOverlayComPortSelected"
                                FontSize="12"
                                TextColor="#d1d5db"/>
                        <Button Grid.Column="1"
                                Text="Refresh"
                                Clicked="OnOverlayRefreshPorts"
                                BackgroundColor="#374151"
                                TextColor="White"
                                CornerRadius="6"
                                WidthRequest="72"
                                FontSize="12"
                                Padding="0,6"/>
                    </Grid>
                    <Label x:Name="OverlayScannerStatusLabel"
                           Text="No scanner connected"
                           FontSize="11"
                           TextColor="#6b7280"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Full-screen verdict flash (spans both rows; above everything) -->
        <Grid x:Name="VerdictOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="False"
              Opacity="0"
              ZIndex="30"
              BackgroundColor="#16a34a">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="14">
                <Label x:Name="VerdictGlyph"
                       Text="&#x2713;"
                       FontSize="120"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="VerdictWord"
                       Text=""
                       FontSize="56"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="VerdictTracking"
                       Text=""
                       FontSize="22"
                       FontFamily="Consolas"
                       TextColor="#f5f5f5"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="VerdictSub"
                       Text=""
                       FontSize="18"
                       TextColor="#e5e7eb"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>

        <!-- COM port dropdown popover -->
        <Grid x:Name="ComPortDropdownBackdrop"
              Grid.Row="0"
              Grid.RowSpan="3"
              BackgroundColor="Transparent"
              IsVisible="False"
              ZIndex="20"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnComPortDropdownBackdropTapped"/>
            </Grid.GestureRecognizers>
            <Border x:Name="ComPortDropdownCard"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,48,16,0"
                    Stroke="#e5e7eb"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6"
                    BackgroundColor="White"
                    Padding="0"
                    WidthRequest="240"
                    InputTransparent="False">
                <Border.Shadow>
                    <Shadow Brush="#26000000" Offset="0,4" Radius="12"/>
                </Border.Shadow>
                <VerticalStackLayout x:Name="ComPortDropdownList"
                                     Spacing="0"
                                     Padding="8"/>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
