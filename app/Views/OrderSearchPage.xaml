<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:app.Models"
             xmlns:views="clr-namespace:app.Views"
             x:Class="app.Views.OrderSearchPage"
             x:DataType="views:OrderSearchPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="NavOutlineButton"
                   TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="Transparent"/>
                <Setter Property="TextColor"
                        Value="White"/>
                <Setter Property="BorderColor"
                        Value="White"/>
                <Setter Property="BorderWidth"
                        Value="1"/>
                <Setter Property="FontSize"
                        Value="12"/>
                <Setter Property="Padding"
                        Value="14,6"/>
                <Setter Property="CornerRadius"
                        Value="6"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="Transparent"/>
                                    <Setter Property="TextColor"
                                            Value="White"/>
                                    <Setter Property="BorderColor"
                                            Value="White"/>
                                    <Setter Property="BorderWidth"
                                            Value="1"/>
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="White"/>
                                    <Setter Property="TextColor"
                                            Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderColor"
                                            Value="White"/>
                                    <Setter Property="BorderWidth"
                                            Value="1"/>
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="#e0e7ff"/>
                                    <Setter Property="TextColor"
                                            Value="{StaticResource Primary}"/>
                                    <Setter Property="BorderColor"
                                            Value="White"/>
                                    <Setter Property="Opacity"
                                            Value="0.85"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="0.35"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Filled button with pointer-over highlight -->
            <Style x:Key="HoverButton"
                   TargetType="Button">
                <Setter Property="CornerRadius"
                        Value="6"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="0.78"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="0.6"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity"
                                            Value="0.35"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, Auto, *">

        <!-- Header bar -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,10">

            <!-- Left: Home + operator badge (visible after login) -->
            <HorizontalStackLayout HorizontalOptions="Start"
                                   Spacing="12"
                                   VerticalOptions="Center">
                <Button Text="⌂ Home"
                        Clicked="OnGoHome"
                        Style="{StaticResource NavOutlineButton}"/>
                <Border x:Name="OperatorHeaderBadge"
                        IsVisible="False"
                        BackgroundColor="#1e3a5f"
                        Stroke="#3b82f6"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 6"
                        Padding="12,5">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <BoxView x:Name="NavOperatorDot"
                                 WidthRequest="8"
                                 HeightRequest="8"
                                 Color="#4ade80"
                                 CornerRadius="4"
                                 VerticalOptions="Center"/>
                        <Label x:Name="NavOperatorLabel"
                               Text=""
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </HorizontalStackLayout>

            <Label Text="Order Search"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <!-- Right: station info + action buttons -->
            <HorizontalStackLayout HorizontalOptions="End"
                                   Spacing="12"
                                   VerticalOptions="Center">
                <Label Text="{Binding StationNameDisplay}"
                       TextColor="White"
                       FontSize="13"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
                <Button Text="Open Logs"
                        Clicked="OnOpenLogs"
                        Style="{StaticResource NavOutlineButton}"/>
                <Button Text="⚙ Settings"
                        Clicked="OnOpenSettings"
                        Style="{StaticResource NavOutlineButton}"/>
            </HorizontalStackLayout>

        </Grid>

        <!-- Fixed top bar: Scanner (1/3) + Search (2/3) -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*, 2*"
              ColumnSpacing="12"
              BackgroundColor="#f3f4f6"
              Padding="24,16,24,12">

            <!-- Scanner card -->
            <Border Grid.Column="0"
                    Stroke="#d1d5db"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="White"
                    Padding="12,10">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Barcode Scanner"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#111827"/>
                    <Grid ColumnDefinitions="*, Auto"
                          ColumnSpacing="8">
                        <Picker x:Name="ComPortPicker"
                                Grid.Column="0"
                                Title="Select COM port"
                                SelectedIndexChanged="OnComPortSelected"
                                FontSize="12"/>
                        <Button Grid.Column="1"
                                Text="Refresh"
                                Clicked="OnRefreshPorts"
                                Style="{StaticResource HoverButton}"
                                WidthRequest="72"
                                FontSize="12"
                                Padding="0,6"/>
                    </Grid>
                    <Label x:Name="ScannerStatusLabel"
                           Text="No scanner connected"
                           FontSize="11"
                           TextColor="#6b7280"
                           MinimumHeightRequest="16"/>
                </VerticalStackLayout>
            </Border>

            <!-- Search card -->
            <Border Grid.Column="1"
                    Stroke="#d1d5db"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="White"
                    Padding="12,10">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Search"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#111827"/>
                    <Grid ColumnDefinitions="*, Auto"
                          ColumnSpacing="8">
                        <Entry x:Name="SearchEntry"
                               Grid.Column="0"
                               Placeholder="Tracking or order number…"
                               FontSize="13"
                               ReturnType="Search"
                               Completed="OnSearchCommitted"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="Search"
                                Clicked="OnSearchClicked"
                                Style="{StaticResource HoverButton}"
                                WidthRequest="80"
                                FontSize="13"
                                Padding="0,6"/>
                    </Grid>
                    <Label x:Name="SearchStatusLabel"
                           Text=" "
                           FontSize="11"
                           TextColor="#6b7280"
                           MinimumHeightRequest="16"/>

                    <!-- History header — hidden when list is empty -->
                    <Grid x:Name="HistoryHeaderRow"
                          ColumnDefinitions="*, Auto"
                          IsVisible="False"
                          Margin="0,4,0,0">
                        <Label Grid.Column="0"
                               Text="Recent searches"
                               FontSize="11"
                               TextColor="#9ca3af"
                               VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="12"
                                               VerticalOptions="Center">
                            <Label Text="Clear all"
                                   FontSize="11"
                                   TextColor="#6b7280"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHistoryClearAll"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="HistoryChevron"
                                   Text="▾"
                                   FontSize="11"
                                   TextColor="#6b7280"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHistoryToggle"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- History dropdown — collapsed by default, populated in code-behind -->
                    <Border x:Name="HistoryDropdown"
                            IsVisible="False"
                            Stroke="#e5e7eb"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="White"
                            Padding="0"
                            Margin="0,4,0,0">
                        <ScrollView MaximumHeightRequest="220">
                            <VerticalStackLayout x:Name="HistoryItemsLayout"
                                                 Spacing="0"
                                                 Padding="4,4"/>
                        </ScrollView>
                    </Border>

                </VerticalStackLayout>
            </Border>

        </Grid>

        <!-- ── Session card + carousel (same row) ────── -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto, *"
              ColumnSpacing="12"
              BackgroundColor="#f3f4f6"
              Padding="24,0,24,12">

            <!-- Left: session status card (in-memory counters) -->
            <Border x:Name="SessionCard"
                    Grid.Column="0"
                    Stroke="#d1d5db"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="White"
                    Padding="12,10">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Session"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#111827"
                               VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="3"
                                               VerticalOptions="Center">
                            <Label x:Name="SessionTotalLabel"
                                   Text="0"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#111827"
                                   VerticalOptions="Center"/>
                            <Label Text="orders"
                                   FontSize="11"
                                   TextColor="#6b7280"
                                   VerticalOptions="End"
                                   Margin="0,0,0,1"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                        <!-- Green: Completed (QC Passed) -->
                        <Border x:Name="SessionCompletedBadge"
                                BackgroundColor="#f0fdf4"
                                Stroke="#bbf7d0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSessionCompletedBadgeTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <BoxView WidthRequest="7" HeightRequest="7"
                                         Color="#166534" CornerRadius="3.5" VerticalOptions="Center"/>
                                <Label x:Name="SessionCompletedLabel"
                                       Text="0" FontSize="18" FontAttributes="Bold"
                                       TextColor="#166534" VerticalOptions="Center"/>
                                <Label Text="Completed" FontSize="10"
                                       TextColor="#166534" VerticalOptions="End" Margin="0,0,0,1"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Yellow: Incompleted (QC Hold) -->
                        <Border x:Name="SessionIncompleteBadge"
                                BackgroundColor="#fffbeb"
                                Stroke="#fde68a"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSessionIncompleteBadgeTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <BoxView WidthRequest="7" HeightRequest="7"
                                         Color="#b45309" CornerRadius="3.5" VerticalOptions="Center"/>
                                <Label x:Name="SessionIncompleteLabel"
                                       Text="0" FontSize="18" FontAttributes="Bold"
                                       TextColor="#b45309" VerticalOptions="Center"/>
                                <Label Text="Incompleted" FontSize="10"
                                       TextColor="#b45309" VerticalOptions="End" Margin="0,0,0,1"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Blue: Incoming (tracking scanned, no items picked) -->
                        <Border x:Name="SessionIncomingBadge"
                                BackgroundColor="#eff6ff"
                                Stroke="#bfdbfe"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSessionIncomingBadgeTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <BoxView WidthRequest="7" HeightRequest="7"
                                         Color="#1d4ed8" CornerRadius="3.5" VerticalOptions="Center"/>
                                <Label x:Name="SessionIncomingLabel"
                                       Text="0" FontSize="18" FontAttributes="Bold"
                                       TextColor="#1d4ed8" VerticalOptions="Center"/>
                                <Label Text="Incoming" FontSize="10"
                                       TextColor="#1d4ed8" VerticalOptions="End" Margin="0,0,0,1"/>
                            </HorizontalStackLayout>
                        </Border>

                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Right: session carousel — fills all remaining width -->
            <Border Grid.Column="1"
                    Stroke="#d1d5db"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="White"
                    Padding="8,8">
                <ScrollView x:Name="NavRow"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            VerticalOptions="Center">
                    <HorizontalStackLayout x:Name="CarouselLayout"
                                           Spacing="6"
                                           VerticalOptions="Center"/>
                </ScrollView>
            </Border>

        </Grid>

        <!-- Scrollable results -->
        <ScrollView x:Name="ResultsScroll"
                    Grid.Row="3"
                    BackgroundColor="#f3f4f6">
            <VerticalStackLayout Padding="24,0,24,24"
                                 Spacing="0">

                <!-- Not-found card -->
                <Border x:Name="NotFoundCard"
                        IsVisible="False"
                        Stroke="#d1d5db"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="White"
                        Padding="24"
                        Margin="0,16,0,0">
                    <Label x:Name="NotFoundLabel"
                           Text=""
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#111827"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </Border>

                <CollectionView x:Name="ResultsView"
                                ItemsSource="{Binding ActiveResults}"
                                SelectionMode="None">

                        <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PackingList">
                            <VerticalStackLayout Spacing="6"
                                                 Margin="0,16,0,0">

                                <!-- Summary card -->
                                <Border Stroke="#d1d5db"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="White"
                                        Padding="14,8">
                                    <VerticalStackLayout Spacing="3">
                                        <!-- Tracking + platform icon + status -->
                                        <Grid ColumnDefinitions="Auto, *, Auto"
                                              ColumnSpacing="10">
                                            <!-- Platform icon (only when known) -->
                                            <Image Grid.Column="0"
                                                   Source="{Binding PlatformIcon}"
                                                   IsVisible="{Binding HasPlatformIcon}"
                                                   WidthRequest="48"
                                                   HeightRequest="48"
                                                   Aspect="AspectFit"
                                                   VerticalOptions="Center"/>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="1"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding TrackingNumber}"
                                                       FontAttributes="Bold"
                                                       FontSize="18"
                                                       TextColor="#111827"/>
                                                <!-- Submitted + Checked at on same line -->
                                                <HorizontalStackLayout Spacing="14">
                                                    <Label FontSize="11"
                                                           TextColor="#9ca3af">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Submitted: "/>
                                                                <Span Text="{Binding CreatedAtDisplay}"
                                                                      TextColor="#6b7280"/>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label FontSize="11"
                                                           TextColor="#9ca3af"
                                                           IsVisible="{Binding HasBeenChecked}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Checked at: "/>
                                                                <Span Text="{Binding CheckedAtDisplay}"
                                                                      TextColor="#6b7280"/>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </HorizontalStackLayout>
                                                <!-- Packed by + Checked by beside tracking -->
                                                <HorizontalStackLayout Spacing="14">
                                                    <Label FontSize="11"
                                                           TextColor="#9ca3af">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Packed by: "/>
                                                                <Span Text="{Binding PackedByDisplay}"
                                                                      TextColor="#6b7280"/>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label FontSize="11"
                                                           TextColor="#9ca3af">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Checked by: "/>
                                                                <Span Text="{Binding CheckedByDisplay}"
                                                                      TextColor="#6b7280"/>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <!-- Status badge(s) + Reset button -->
                                            <VerticalStackLayout Grid.Column="2"
                                                                 Spacing="3"
                                                                 HorizontalOptions="End"
                                                                 VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="4"
                                                                       HorizontalOptions="End">
                                                    <Border BackgroundColor="{Binding StatusBgColor}"
                                                            Stroke="Transparent"
                                                            StrokeShape="RoundRectangle 4"
                                                            Padding="10,5">
                                                        <Label Text="{Binding StatusDisplay}"
                                                               TextColor="{Binding StatusFgColor}"
                                                               FontSize="15"
                                                               FontAttributes="Bold"/>
                                                    </Border>
                                                    <!-- Green "✓ QC Passed" — only when Packed Complete -->
                                                    <Border IsVisible="{Binding IsPackedComplete}"
                                                            BackgroundColor="#dcfce7"
                                                            Stroke="#86efac"
                                                            StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 4"
                                                            Padding="10,5">
                                                        <Label Text="✓ QC Passed"
                                                               TextColor="#166534"
                                                               FontSize="15"
                                                               FontAttributes="Bold"/>
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <!-- Reset — always reserves height so all cards stay the same size -->
                                                <Button Text="Reset"
                                                        Clicked="OnResetClicked"
                                                        Opacity="{Binding ResetOpacity}"
                                                        InputTransparent="{Binding IsNotQcHold}"
                                                        HorizontalOptions="End"
                                                        FontSize="11"
                                                        Padding="8,3"
                                                        BackgroundColor="#fef9c3"
                                                        TextColor="#713f12"
                                                        CornerRadius="6"
                                                        BorderColor="#fde68a"
                                                        BorderWidth="1"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                        <!-- Meta row -->
                                        <HorizontalStackLayout Spacing="16">
                                            <Label FontSize="11"
                                                   TextColor="#6b7280">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Order: "
                                                              TextColor="#9ca3af"/>
                                                        <Span Text="{Binding OrderNumber}"
                                                              TextColor="#374151"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="11"
                                                   TextColor="#6b7280">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Items: "
                                                              TextColor="#9ca3af"/>
                                                        <Span Text="{Binding TotalItemsDisplay}"
                                                              TextColor="#374151"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <HorizontalStackLayout Spacing="3"
                                                                   VerticalOptions="Center"
                                                                   IsVisible="{Binding HasBeenUpdated}">
                                                <Label Text="↻"
                                                       TextColor="#2563eb"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                                <Label FontSize="11"
                                                       TextColor="#6b7280"
                                                       VerticalOptions="Center">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Updated: "
                                                                  TextColor="#9ca3af"/>
                                                            <Span Text="{Binding UpdatedAtDisplay}"
                                                                  TextColor="#374151"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Individual product cards -->
                                <VerticalStackLayout IsVisible="{Binding HasProducts}"
                                                     BindableLayout.ItemsSource="{Binding ParsedProducts}"
                                                     Spacing="4">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProductItem">
                                            <Border Stroke="#e5e7eb"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 6"
                                                    BackgroundColor="{Binding CardBgColor}"
                                                    Padding="14,10">
                                                <Border.GestureRecognizers>
                                                    <PointerGestureRecognizer
                                                        PointerEntered="OnProductCardEntered"
                                                        PointerExited="OnProductCardExited"/>
                                                </Border.GestureRecognizers>
                                                <!-- Columns: Product | div | Variation | div | Req Qty | div | Qty -->
                                                <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto, Auto, Auto"
                                                      ColumnSpacing="12">

                                                    <!-- Col 0 · Product — name + important info + SKU tag -->
                                                    <VerticalStackLayout Grid.Column="0"
                                                                         Spacing="4"
                                                                         VerticalOptions="Center"
                                                                         InputTransparent="True">
                                                        <Label Text="{Binding BaseName}"
                                                               FontAttributes="Bold"
                                                               FontSize="13"
                                                               TextColor="#111827"
                                                               LineBreakMode="WordWrap"/>
                                                        <Label Text="{Binding ImportantInfo}"
                                                               IsVisible="{Binding HasImportantInfo}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               TextColor="#dc2626"
                                                               LineBreakMode="WordWrap"/>
                                                        <Border BackgroundColor="#f3f4f6"
                                                                Stroke="#e5e7eb"
                                                                StrokeThickness="1"
                                                                StrokeShape="RoundRectangle 4"
                                                                Padding="6,2"
                                                                HorizontalOptions="Start">
                                                            <Label FontSize="11"
                                                                   TextColor="#374151">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="SKU: " TextColor="#9ca3af"/>
                                                                        <Span Text="{Binding SellerSku}" FontAttributes="Bold"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                        </Border>
                                                    </VerticalStackLayout>

                                                    <BoxView Grid.Column="1" WidthRequest="1" BackgroundColor="#e5e7eb" VerticalOptions="Fill" InputTransparent="True"/>

                                                    <!-- Col 2 · Variation -->
                                                    <VerticalStackLayout Grid.Column="2"
                                                                         HorizontalOptions="Center"
                                                                         VerticalOptions="Center"
                                                                         Spacing="4"
                                                                         InputTransparent="True"
                                                                         MinimumWidthRequest="60">
                                                        <Border IsVisible="{Binding HasVariation}"
                                                                BackgroundColor="#eff6ff"
                                                                Stroke="#bfdbfe"
                                                                StrokeThickness="1"
                                                                StrokeShape="RoundRectangle 4"
                                                                Padding="8,3"
                                                                HorizontalOptions="Center">
                                                            <Label Text="{Binding Variation}"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#1d4ed8"/>
                                                        </Border>
                                                        <Label IsVisible="{Binding HasNoVariation}"
                                                               Text="—"
                                                               FontSize="11"
                                                               TextColor="#d1d5db"
                                                               HorizontalTextAlignment="Center"/>
                                                        <Label Text="variation"
                                                               FontSize="10"
                                                               TextColor="#9ca3af"
                                                               HorizontalTextAlignment="Center"/>
                                                    </VerticalStackLayout>

                                                    <BoxView Grid.Column="3" WidthRequest="1" BackgroundColor="#e5e7eb" VerticalOptions="Fill" InputTransparent="True"/>

                                                    <!-- Col 4 · Req Qty -->
                                                    <VerticalStackLayout Grid.Column="4"
                                                                         HorizontalOptions="Center"
                                                                         VerticalOptions="Center"
                                                                         Spacing="2"
                                                                         InputTransparent="True">
                                                        <Label Text="{Binding RequiredQuantity}"
                                                               FontSize="28"
                                                               FontAttributes="Bold"
                                                               TextColor="#6b7280"
                                                               HorizontalTextAlignment="Center"/>
                                                        <Label Text="req qty"
                                                               FontSize="10"
                                                               TextColor="#9ca3af"
                                                               HorizontalTextAlignment="Center"/>
                                                    </VerticalStackLayout>

                                                    <BoxView Grid.Column="5" WidthRequest="1" BackgroundColor="#e5e7eb" VerticalOptions="Fill" InputTransparent="True"/>

                                                    <!-- Col 6 · Qty + pick entry -->
                                                    <VerticalStackLayout Grid.Column="6"
                                                                         HorizontalOptions="Center"
                                                                         VerticalOptions="Center"
                                                                         Spacing="2">
                                                        <VerticalStackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnQuantityTapped"/>
                                                        </VerticalStackLayout.GestureRecognizers>
                                                        <HorizontalStackLayout HorizontalOptions="Center"
                                                                               Spacing="10"
                                                                               VerticalOptions="Center">
                                                            <Label Text="{Binding Quantity}"
                                                                   FontSize="28"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#111827"
                                                                   VerticalOptions="Center"/>
                                                            <Entry IsVisible="{Binding IsBeingPicked}"
                                                                   Text="{Binding PickQtyText}"
                                                                   Keyboard="Numeric"
                                                                   WidthRequest="64"
                                                                   FontSize="20"
                                                                   FontAttributes="Bold"
                                                                   HorizontalTextAlignment="Center"
                                                                   ReturnType="Done"
                                                                   Completed="OnPickQtyEntryCompleted"
                                                                   TextChanged="OnPickQtyTextChanged"
                                                                   VerticalOptions="Center"/>
                                                        </HorizontalStackLayout>
                                                        <Label Text="qty"
                                                               FontSize="10"
                                                               TextColor="#9ca3af"
                                                               HorizontalTextAlignment="Center"
                                                               InputTransparent="True"/>
                                                    </VerticalStackLayout>

                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Welcome animation banner — briefly shown after login -->
        <Border x:Name="WelcomeBanner"
                Grid.Row="1"
                Grid.RowSpan="3"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="#1e3a5f"
                Stroke="#3b82f6"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="36,22"
                InputTransparent="True"
                ZIndex="9">
            <Label x:Name="WelcomeLabel"
                   Text=""
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>
        </Border>

        <!-- Login overlay — dark blur-like backdrop until operator scans badge -->
        <Grid x:Name="LoginOverlay"
              Grid.Row="1"
              Grid.RowSpan="3"
              BackgroundColor="#CC111827"
              IsVisible="True"
              ZIndex="10">
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="#374151"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#1f2937"
                    Padding="44,36"
                    WidthRequest="400">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">
                    <Label Text="Please scan your badge"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"/>
                    <BoxView HeightRequest="1"
                             BackgroundColor="#374151"
                             Margin="0,4"/>
                    <Grid ColumnDefinitions="*, Auto"
                          ColumnSpacing="8">
                        <Picker x:Name="OverlayComPortPicker"
                                Grid.Column="0"
                                Title="Select COM port"
                                SelectedIndexChanged="OnOverlayComPortSelected"
                                FontSize="12"
                                TextColor="#d1d5db"/>
                        <Button Grid.Column="1"
                                Text="Refresh"
                                Clicked="OnOverlayRefreshPorts"
                                BackgroundColor="#374151"
                                TextColor="White"
                                CornerRadius="6"
                                WidthRequest="72"
                                FontSize="12"
                                Padding="0,6"/>
                    </Grid>
                    <Label x:Name="OverlayScannerStatusLabel"
                           Text="No scanner connected"
                           FontSize="11"
                           TextColor="#6b7280"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
