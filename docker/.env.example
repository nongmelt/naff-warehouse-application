# ============================================================
# NAFF Warehouse Application — Environment Configuration
# ============================================================
# Copy this file to docker/.env and fill in your values.
# Generated: 21/04/2026
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
# Full connection URL (used by backend)
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/warehouse

# ── MinIO ─────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=warehouse-videos

MINIO_PRODUCT_IMAGES_BUCKET=product-images
MINIO_MAX_IMAGE_SIZE=10MB
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── Rust Backend ──────────────────────────────────────────
BACKEND_PORT=8080
# Behind Traefik the browser origin is the frontend host. For local dev use
# http://localhost:3000 instead.
CORS_ORIGIN=http://app.warehouse.local
BACKEND_VERSION=1.0.0


# ── Next.js Frontend ──────────────────────────────────────
# NOTE: these are baked into the frontend image at BUILD time. Changing them
# requires a rebuild (docker compose build frontend), not just a restart.
# Behind Traefik, point them at the *.warehouse.local hosts. For local dev use
# the http://localhost:<port> values instead.
NEXT_PUBLIC_API_URL=http://api.warehouse.local
NEXT_PUBLIC_WS_URL=ws://api.warehouse.local/packing-lists/events
NEXT_PUBLIC_MINIO_URL=http://minio.warehouse.local
NEXT_PUBLIC_MINIO_BUCKET=warehouse-videos


# ── n8n ───────────────────────────────────────────────────
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=host.docker.internal
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=changeme