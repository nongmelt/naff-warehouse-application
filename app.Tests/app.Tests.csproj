<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>app.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Link the single pure file under test; no MAUI dependency. -->
  <ItemGroup>
    <Compile Include="..\app\Services\PackVerdict.cs" Link="PackVerdict.cs" />
    <Compile Include="..\app\Services\ShippingHistory.cs" Link="ShippingHistory.cs" />
    <Compile Include="..\app\Services\OrphanCapture.cs" Link="Services\OrphanCapture.cs" />
  </ItemGroup>

</Project>
